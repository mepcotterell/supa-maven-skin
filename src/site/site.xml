<?xml version="1.0" encoding="UTF-8"?>
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Supa Maven Skin">

  <skin>
    <groupId>${project.groupId}</groupId>
    <artifactId>${project.artifactId}</artifactId>
    <version>${project.version}</version>
  </skin>

  <custom>
    <supaSkin>
      <defaultTheme>auto</defaultTheme>
      <announcement>Supa Maven Skin — Sphinx Furo aesthetics powered by Bootstrap 6 (Alpha) &amp; Vite.</announcement>
      <sourceRepository>https://github.com/mepcotterell/supa-maven-skin</sourceRepository>
      <sourceBranch>main</sourceBranch>
      <sourceDirectory>src/site</sourceDirectory>
      <sourceEditButton>true</sourceEditButton>
      <sourceViewButton>true</sourceViewButton>
      <breadcrumb>true</breadcrumb>
      <tocSidebar>true</tocSidebar>
      <tocTitle>On this page</tocTitle>
      <tocMaxDepth>4</tocMaxDepth>
      <prevNextButtons>true</prevNextButtons>
      <sidebarCollapseDepth>1</sidebarCollapseDepth>
      <copyCodeButton>true</copyCodeButton>
      <syntaxHighlighting>true</syntaxHighlighting>
      <headingPermalinks>true</headingPermalinks>
      <search>true</search>
      <mermaid>auto</mermaid>
      <katex>auto</katex>
    </supaSkin>
  </custom>

  <body>
    <menu name="Documentation">
      <item name="Overview" href="index.html" />
      <item name="Configuration Reference" href="configuration.html" />
      <item name="Kitchen Sink Showcase" href="kitchen-sink.html">
        <item name="Admonitions" href="kitchen-sink.html#furo-admonitions" />
        <item name="Code Blocks &amp; Tabs" href="kitchen-sink.html#syntax-highlighting-copy-button" />
        <item name="Responsive Tables" href="kitchen-sink.html#responsive-doxia-tables" />
        <item name="Bootstrap 6 UI" href="kitchen-sink.html#bootstrap-6-ui-components" />
        <item name="Diagrams &amp; Math" href="kitchen-sink.html#diagrams-mathematical-notation" />
      </item>
      <item name="Bootstrap 6 Components" href="bootstrap-components.html">
        <item name="1. Actions &amp; Buttons" href="bootstrap-components.html#1-actions-buttons" />
        <item name="2. Badges, Avatars &amp; Chips" href="bootstrap-components.html#2-badges-avatars-chips-indicators" />
        <item name="3. Alerts &amp; Overlays" href="bootstrap-components.html#3-alerts-overlays-dialogs-drawers-toasts" />
        <item name="4. Navigation &amp; Steppers" href="bootstrap-components.html#4-navigation-menus-tabs-breadcrumbs-pagination-steppers" />
        <item name="5. Accordions &amp; Cards" href="bootstrap-components.html#5-containers-disclosure-accordions-cards-list-groups-carousel" />
        <item name="6. Forms &amp; Rich Inputs" href="bootstrap-components.html#6-forms-bootstrap-6-rich-input-widgets" />
      </item>
    </menu>
    <menu ref="reports" inherit="bottom" />
  </body>
</site>
