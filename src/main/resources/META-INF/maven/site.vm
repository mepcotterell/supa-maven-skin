#set( $darkLogo = $site.getCustomValue( "${skinCfg}.darkLogo", '' ) )
#set( $announcement = $site.getCustomValue( "${skinCfg}.announcement", '' ) )
#set( $sourceRepo = $site.getCustomValue( "${skinCfg}.sourceRepository", '' ) )
#set( $sourceBranch = $site.getCustomValue( "${skinCfg}.sourceBranch", 'main' ) )
#set( $sourceDir = $site.getCustomValue( "${skinCfg}.sourceDirectory", 'src/site' ) )
#set( $sourceEditBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.sourceEditButton", 'true' ) ) )
#set( $sourceViewBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.sourceViewButton", 'true' ) ) )
#set( $showBreadcrumb = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.breadcrumb", 'true' ) ) )
#set( $stickyContentHeader = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.stickyContentHeader", 'false' ) ) )
#set( $tocSidebar = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.tocSidebar", 'true' ) ) )
#set( $tocTitle = $site.getCustomValue( "${skinCfg}.tocTitle", 'On this page' ) )
#set( $tocMaxDepth = $convert.toNumber( $site.getCustomValue( "${skinCfg}.tocMaxDepth", '4' ) ) )
#set( $prevNextBtns = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.prevNextButtons", 'true' ) ) )
#set( $sidebarCollapseDepth = $convert.toNumber( $site.getCustomValue( "${skinCfg}.sidebarCollapseDepth", '1' ) ) )
#set( $drawerScrollDefault = $site.getCustomValue( "${skinCfg}.drawerBodyScroll", 'false' ) )
#set( $drawerScroll = $site.getCustomValue( "${skinCfg}.drawerScroll", $drawerScrollDefault ) )
#set( $drawerBackdrop = $site.getCustomValue( "${skinCfg}.drawerBackdrop", 'true' ) )
#set( $sidebarDrawerScrollDefault = $site.getCustomValue( "${skinCfg}.sidebarDrawerBodyScroll", $drawerScroll ) )
#set( $sidebarDrawerScroll = $site.getCustomValue( "${skinCfg}.sidebarDrawerScroll", $sidebarDrawerScrollDefault ) )
#set( $sidebarDrawerBackdrop = $site.getCustomValue( "${skinCfg}.sidebarDrawerBackdrop", $drawerBackdrop ) )
#set( $tocDrawerScrollDefault = $site.getCustomValue( "${skinCfg}.tocDrawerBodyScroll", $drawerScroll ) )
#set( $tocDrawerScroll = $site.getCustomValue( "${skinCfg}.tocDrawerScroll", $tocDrawerScrollDefault ) )
#set( $tocDrawerBackdrop = $site.getCustomValue( "${skinCfg}.tocDrawerBackdrop", $drawerBackdrop ) )
#set( $footerTimestamp = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.footerTimestamp", 'true' ) ) )
#set( $footerVersion = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.footerVersion", 'true' ) ) )
#set( $copyCodeBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.copyCodeButton", 'true' ) ) )
#set( $syntaxHighlighting = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.syntaxHighlighting", 'true' ) ) )
#set( $headingPermalinks = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.headingPermalinks", 'true' ) ) )
#set( $permalinkSymbol = $site.getCustomValue( "${skinCfg}.headingPermalinkSymbol", '#' ) )
#set( $enableSearch = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.search", 'true' ) ) )
#set( $mermaidMode = $site.getCustomValue( "${skinCfg}.mermaid", 'auto' ) )
#set( $mermaidCdnUrl = $site.getCustomValue( "${skinCfg}.mermaidCdnUrl", 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs' ) )
#set( $katexMode = $site.getCustomValue( "${skinCfg}.katex", 'auto' ) )
#set( $katexCssCdnUrl = $site.getCustomValue( "${skinCfg}.katexCssCdnUrl", 'https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css' ) )
#set( $katexJsCdnUrl = $site.getCustomValue( "${skinCfg}.katexJsCdnUrl", 'https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.mjs' ) )
##
<!--
 | Generated by #generatedBy()##
#if( $docRenderingContext && ( $docRenderingContext.generator || $docRenderingContext.doxiaSource ) ) from##
#if( $docRenderingContext.generator ) $docRenderingContext.generator#end##
#if( $docRenderingContext.doxiaSource ) $docRenderingContext.doxiaSourcePath#end##
#end

 | Rendered using Supa Maven Skin @project.version@ (Bootstrap 6.0.0-alpha.1)
-->
<html lang="$locale.language"
      data-supa-default-theme="$esc.html( $defaultTheme )"
      data-supa-default-palette="$esc.html( $colorScheme )"
      data-supa-palette="$esc.html( $colorScheme )"
      data-supa-project-version="#if( $project && $project.version )$esc.html( $project.version )#else 0.1.0#end"
      data-supa-relative-path="$relativePath">
  <head>
    <meta charset="${outputEncoding}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="#generatedBy()" />
#foreach( $author in $authors )
    <meta name="author" content="$esc.html( $author )" />
#end
#if( $dateCreation )
    <meta name="date" content="$esc.html( $dateCreation )" />
#end
    <title>$esc.html( $title )</title>

    <!-- Early Theme & Palette Initialization (Prevents FOUC with Bootstrap 6 color-scheme & data-supa-palette) -->
    <script>
      (function () {
        var root = document.documentElement;
        var themeKey = 'supa-theme';
        var paletteKey = 'supa-palette';
        var defaultMode = root.getAttribute('data-supa-default-theme') || 'auto';
        var defaultPalette = root.getAttribute('data-supa-default-palette') || 'furo';
        var storedMode = null;
        var storedPalette = null;
        try {
          storedMode = localStorage.getItem(themeKey);
          storedPalette = localStorage.getItem(paletteKey);
        } catch (e) {}
        var mode = (storedMode === 'light' || storedMode === 'dark' || storedMode === 'auto')
          ? storedMode
          : defaultMode;
        root.setAttribute('data-supa-theme-mode', mode);
        if (mode === 'light' || mode === 'dark') {
          root.setAttribute('data-bs-theme', mode);
          root.setAttribute('data-supa-resolved-theme', mode);
        } else {
          root.removeAttribute('data-bs-theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.setAttribute('data-supa-resolved-theme', prefersDark ? 'dark' : 'light');
        }
        var validPalettes = {
          'furo': true,
          'bootstrap': true,
          'modus': true,
          'modus-tinted': true,
          'modus-deuteranopia': true,
          'modus-tritanopia': true
        };
        var palette = (storedPalette && validPalettes[storedPalette]) ? storedPalette : defaultPalette;
        root.setAttribute('data-supa-palette', palette);
        if (storedPalette && validPalettes[storedPalette]) {
          root.setAttribute('data-supa-palette-locked', 'true');
        }
      })();
    </script>

    <link rel="stylesheet" href="$relativePath/css/supa-maven-skin.min.css" />
    <link rel="stylesheet" href="$relativePath/css/site.css" onerror="this.remove()" />
##
## Inject Furo-style <lightCssVariables> and <darkCssVariables> overrides from site.xml
#set( $lightVars = $site.getCustomChild( "${skinCfg}.lightCssVariables" ) )
#set( $darkVars = $site.getCustomChild( "${skinCfg}.darkCssVariables" ) )
#if( ( $lightVars && $lightVars.getChildren().size() > 0 ) || ( $darkVars && $darkVars.getChildren().size() > 0 ) )
    <style id="supa-custom-css-variables">
#if( $lightVars && $lightVars.getChildren().size() > 0 )
      html:root, html[data-bs-theme="light"], html[data-supa-palette] {
#foreach( $child in $lightVars.getChildren() )
        --$child.getName(): $child.getValue();
#end
      }
#end
#if( $darkVars && $darkVars.getChildren().size() > 0 )
      html[data-bs-theme="dark"], html[data-supa-palette][data-bs-theme="dark"] {
#foreach( $child in $darkVars.getChildren() )
        --$child.getName(): $child.getValue();
#end
      }
      @media (prefers-color-scheme: dark) {
        html:root:not([data-bs-theme="light"]), html[data-supa-palette]:not([data-bs-theme="light"]) {
#foreach( $child in $darkVars.getChildren() )
          --$child.getName(): $child.getValue();
#end
        }
      }
#end
    </style>
#end
#if( $site.body.head )
    $render.eval( $site.body.head )
#end
#if( $headContent )
    $headContent
#end
  </head>
  <body class="supa-body#if( $stickyContentHeader ) supa-sticky-content-header#end"
        data-supa-toc="$tocSidebar"
        data-supa-toc-max-depth="$tocMaxDepth"
        data-supa-copy-code="$copyCodeBtn"
        data-supa-syntax-highlight="$syntaxHighlighting"
        data-supa-permalinks="$headingPermalinks"
        data-supa-permalink-symbol="$esc.html( $permalinkSymbol )"
        data-supa-search="$enableSearch"
        data-supa-mermaid="$esc.html( $mermaidMode )"
        data-supa-mermaid-url="$esc.html( $mermaidCdnUrl )"
        data-supa-katex="$esc.html( $katexMode )"
        data-supa-katex-css-url="$esc.html( $katexCssCdnUrl )"
        data-supa-katex-js-url="$esc.html( $katexJsCdnUrl )">

    <a class="supa-skip-link visually-hidden-focusable" href="#supa-main-content">Skip to content</a>

#if( $announcement && $announcement != "" )
    <!-- Optional Top Announcement Banner -->
    <div class="supa-announcement" role="region" aria-label="Announcement">
      <div class="supa-announcement-content">$announcement</div>
    </div>
#end

    <!-- Mobile / Tablet Sticky Header Bar (< lg) -->
    <header class="supa-mobile-header lg:d-none">
      <div class="supa-mobile-header-left">
        <button type="button"
                class="supa-icon-btn"
                data-bs-toggle="drawer"
                data-bs-target="#supaSidebarDrawer"
                data-bs-placement="bottom"
                data-bs-title="Toggle navigation sidebar"
                aria-controls="supaSidebarDrawer"
                aria-label="Toggle navigation sidebar">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="supa-mobile-header-center">
        <a class="supa-mobile-brand" href="$relativePath/index.html">
#if( $site.name )
          $esc.html( $site.name )
#elseif( $project && $project.name )
          $esc.html( $project.name )
#else
          Documentation
#end
        </a>
      </div>
      <div class="supa-mobile-header-right">
#if( $colorSchemeSelector )
#supaPalettePicker( "" "bottom-end" )
#end
#supaThemeToggle( "" "bottom-end" )
#if( $enableSearch )
        <button type="button"
                class="supa-icon-btn"
                data-bs-toggle="dialog"
                data-bs-target="#supaSearchDialog"
                data-bs-placement="bottom"
                data-bs-title="Search documentation"
                aria-label="Search documentation">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
#end
#if( $tocSidebar )
        <button type="button"
                class="supa-icon-btn supa-toc-drawer-trigger"
                data-bs-toggle="drawer"
                data-bs-target="#supaTocDrawer"
                data-bs-placement="bottom"
                data-bs-title="$esc.html( $tocTitle )"
                aria-controls="supaTocDrawer"
                aria-label="Toggle table of contents">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="9" y1="12" x2="21" y2="12"></line>
            <line x1="6" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
#end
      </div>
    </header>

    <!-- Main 3-Column Furo Page Grid -->
    <div class="supa-page">
      <!-- 1. Left Navigation Sidebar (Inline on lg+, Bootstrap 6 Left Drawer below lg) -->
      <aside class="supa-sidebar-column" aria-label="Primary navigation">
        <dialog class="lg:drawer drawer-start supa-sidebar-drawer"
                id="supaSidebarDrawer"
                data-bs-scroll="$esc.html( $sidebarDrawerScroll )"
                data-bs-backdrop="$esc.html( $sidebarDrawerBackdrop )"
                tabindex="-1"
                aria-labelledby="supaSidebarBrandText">
          <div class="drawer-header lg:d-none supa-drawer-header">
            <span class="drawer-title fw-semibold">Navigation</span>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close navigation"></button>
          </div>

          <div class="drawer-body supa-sidebar-container">
            <!-- Brand / Logo Area -->
#set( $brandHref = "$relativePath/index.html" )
#if( $site.bannerLeft && $site.bannerLeft.href )
#supaResolveHref( $site.bannerLeft.href )
#set( $brandHref = $resolvedHref )
#end
            <a class="supa-sidebar-brand" data-supa-brand-align="$esc.html( $sidebarBrandAlign )" href="$brandHref">
#if( $lightLogo != "" && $darkLogo != "" )
#supaResolveHref( $lightLogo )
#set( $lightLogoUrl = $resolvedHref )
#supaResolveHref( $darkLogo )
#set( $darkLogoUrl = $resolvedHref )
              <div class="supa-sidebar-logo-container">
                <img class="supa-sidebar-logo only-light" src="$lightLogoUrl" alt="Light Logo" />
                <img class="supa-sidebar-logo only-dark" src="$darkLogoUrl" alt="Dark Logo" />
              </div>
#elseif( $lightLogo != "" )
#supaResolveHref( $lightLogo )
              <div class="supa-sidebar-logo-container">
                <img class="supa-sidebar-logo" src="$resolvedHref" alt="Logo" />
              </div>
#elseif( $site.bannerLeft && $site.bannerLeft.image && $site.bannerLeft.image.src )
#supaResolveHref( $site.bannerLeft.image.src )
              <div class="supa-sidebar-logo-container">
                <img class="supa-sidebar-logo" src="$resolvedHref" alt="#if( $site.bannerLeft.name )$esc.html( $site.bannerLeft.name )#else Logo#end" />
              </div>
#end
#if( !$sidebarHideName )
              <div class="supa-brand-meta">
                <span class="supa-brand-text" id="supaSidebarBrandText">
#if( $site.bannerLeft && $site.bannerLeft.name )
                  $esc.html( $site.bannerLeft.name )
#elseif( $site.name )
                  $esc.html( $site.name )
#elseif( $project && $project.name )
                  $esc.html( $project.name )
#else
                  Documentation
#end
                </span>
#if( $project && $project.version && $footerVersion )
                <span class="supa-version-badge badge theme-secondary">$esc.html( $project.version )</span>
#end
              </div>
#end
            </a>

#if( $enableSearch )
            <!-- Sidebar Search Trigger -->
            <div class="supa-sidebar-search">
              <button type="button"
                      class="supa-search-trigger"
                      data-bs-toggle="dialog"
                      data-bs-target="#supaSearchDialog"
                      aria-label="Search documentation (Press / or Command+K)">
                <svg class="supa-search-trigger-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span class="supa-search-trigger-placeholder">Search</span>
                <kbd class="supa-search-kbd" aria-hidden="true">&#x2318;K</kbd>
              </button>
            </div>
#end

            <!-- Hierarchical Site Navigation Tree -->
            <nav class="supa-sidebar-tree" aria-label="Site navigation">
#supaSidebarMenus( $site.body.menus $sidebarCollapseDepth )
            </nav>

            <!-- Mobile / Tablet Drawer Appearance Footer (< lg) -->
            <div class="supa-sidebar-footer lg:d-none">
              <div class="supa-sidebar-footer-group">
                <span class="supa-sidebar-footer-label">Appearance</span>
                <div class="supa-sidebar-footer-controls">
#if( $colorSchemeSelector )
#supaPalettePicker( "" "top-start" )
#end
#supaThemeToggle( "" "top-end" )
                </div>
              </div>
            </div>
          </div>
        </dialog>
      </aside>

      <!-- 2. Center Main Content Area -->
      <div class="supa-main">
        <div class="supa-content">
          <div class="supa-article-container">
            <!-- Top Content Utility Bar (Breadcrumbs, Source Links, Palette Picker, Theme Toggle, Tablet TOC Button) -->
            <div class="supa-content-header not-prose">
              <div class="supa-header-left">
#if( $showBreadcrumb )
                <nav aria-label="Breadcrumb" class="supa-breadcrumb-nav">
                  <ol class="breadcrumb mb-0 supa-breadcrumb">
                    <li class="breadcrumb-item">
                      <a href="$relativePath/index.html">#if( $site.name )$esc.html( $site.name )#elseif( $project && $project.name )$esc.html( $project.name )#else Home#end</a>
                    </li>
#if( $site.body.breadcrumbs && $site.body.breadcrumbs.size() > 0 )
#foreach( $crumb in $site.body.breadcrumbs )
                    <li class="breadcrumb-item">
#if( $crumb.href )
                      <a href="$crumb.href">$esc.html( $crumb.name )</a>
#else
                      <span>$esc.html( $crumb.name )</span>
#end
                    </li>
#end
#end
#if( $shortTitle )
                    <li class="breadcrumb-item active" aria-current="page">
                      $esc.html( $shortTitle )
                    </li>
#end
                  </ol>
                </nav>
#end
              </div>

              <div class="supa-header-right">
#if( $sourceRepo && $sourceRepo != "" && $docRenderingContext && $docRenderingContext.doxiaSource )
#set( $doxiaPath = $docRenderingContext.doxiaSourcePath.replace( '\\', '/' ) )
#if( $sourceDir != "" && !$doxiaPath.startsWith( $sourceDir ) )
#set( $repoFilePath = "$sourceDir/$doxiaPath" )
#else
#set( $repoFilePath = $doxiaPath )
#end
#if( $sourceViewBtn )
                <a class="supa-icon-btn"
                   href="${sourceRepo}/blob/${sourceBranch}/${repoFilePath}"
                   target="_blank"
                   rel="noopener noreferrer"
                   data-bs-toggle="tooltip"
                   data-bs-placement="bottom"
                   data-bs-title="View page source"
                   aria-label="View page source">
                  <i class="bi bi-file-earmark-code" aria-hidden="true"></i>
                </a>
#end
#if( $sourceEditBtn )
                <a class="supa-icon-btn"
                   href="${sourceRepo}/edit/${sourceBranch}/${repoFilePath}"
                   target="_blank"
                   rel="noopener noreferrer"
                   data-bs-toggle="tooltip"
                   data-bs-placement="bottom"
                   data-bs-title="Edit this page"
                   aria-label="Edit this page">
                  <i class="bi bi-pencil-square" aria-hidden="true"></i>
                </a>
#end
#end
#if( $colorSchemeSelector )
#supaPalettePicker( "d-none lg:d-inline-flex" "bottom-end" )
#end
#supaThemeToggle( "d-none lg:d-inline-flex" "bottom-end" )
#if( $tocSidebar )
                <button type="button"
                        class="supa-icon-btn supa-toc-drawer-trigger d-none lg:d-inline-flex xl:d-none"
                        data-bs-toggle="drawer"
                        data-bs-target="#supaTocDrawer"
                        data-bs-placement="bottom"
                        data-bs-title="$esc.html( $tocTitle )"
                        aria-controls="supaTocDrawer"
                        aria-label="Toggle table of contents">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="9" y1="12" x2="21" y2="12"></line>
                    <line x1="6" y1="18" x2="21" y2="18"></line>
                  </svg>
                </button>
#end
              </div>
            </div>

            <!-- Main Article Prose Content -->
            <main id="supa-main-content" class="supa-article prose" role="main">
              $bodyContent
            </main>

#if( $prevNextBtns )
            <!-- Previous / Next Page Navigation Cards -->
#supaPrevNextNavigation( $site.body.menus )
#end

            <!-- Page Footer -->
            <footer class="supa-footer not-prose">
              <div class="supa-footer-meta">
                <div class="supa-footer-left">
#if( $site.body.footer )
                  <div class="supa-custom-footer">$render.eval( $site.body.footer )</div>
#else
                  <div class="supa-copyright">
                    Copyright &#169; #supaCopyright().
                  </div>
#end
                  <div class="supa-built-with">
                    Built with <a href="https://maven.apache.org/plugins/maven-site-plugin/">Maven Site</a> and <a href="https://github.com/mepcotterell/supa-maven-skin">Supa Maven Skin</a> (Bootstrap 6).
#if( $footerTimestamp )
#if( $date )
                    <span class="supa-last-updated">Last updated on $date.get( 'yyyy-MM-dd' ).</span>
#elseif( $dateFormat && $currentDate )
                    <span class="supa-last-updated">Last updated on $dateFormat.format( $currentDate ).</span>
#end
#end
                  </div>
                </div>

#set( $navIcons = $site.getCustomChild( "${skinCfg}.navIcons" ) )
                <div class="supa-footer-right">
#if( $navIcons && $navIcons.getChildren().size() > 0 )
                  <div class="supa-footer-icons">
#foreach( $iconNode in $navIcons.getChildren() )
#set( $iconHref = $iconNode.getChild( 'href' ).getValue() )
#set( $iconTitle = $iconNode.getChild( 'title' ).getValue() )
#set( $iconHtml = $iconNode.getChild( 'html' ).getValue() )
#if( $iconHref )
                    <a class="supa-footer-icon-link" href="$iconHref"#if( $iconTitle ) data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="$esc.html( $iconTitle )" aria-label="$esc.html( $iconTitle )"#end target="_blank" rel="noopener noreferrer">
#if( $iconHtml )
                      $iconHtml
#elseif( $iconTitle )
                      $esc.html( $iconTitle )
#end
                    </a>
#end
#end
                  </div>
#end
                </div>
              </div>
            </footer>
          </div>
        </div>

#if( $tocSidebar )
        <!-- 3. Right Table of Contents Sidebar ("On this page" — Inline on xl+, Bootstrap 6 Right Drawer below xl) -->
        <aside class="supa-toc-column" aria-label="On this page">
          <dialog class="xl:drawer drawer-end supa-toc-drawer"
                  id="supaTocDrawer"
                  data-bs-scroll="$esc.html( $tocDrawerScroll )"
                  data-bs-backdrop="$esc.html( $tocDrawerBackdrop )"
                  tabindex="-1"
                  aria-labelledby="supaTocDrawerTitle">
            <div class="drawer-header xl:d-none supa-drawer-header">
              <span class="drawer-title fw-semibold" id="supaTocDrawerTitle">$esc.html( $tocTitle )</span>
              <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close table of contents"></button>
            </div>
            <div class="drawer-body supa-toc-container">
              <div class="supa-toc-title">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="9" y1="12" x2="21" y2="12"></line>
                  <line x1="6" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>$esc.html( $tocTitle )</span>
              </div>
              <div class="supa-toc-scroll">
                <nav id="supaTocNav" class="nav flex-column supa-toc-nav" aria-label="$esc.html( $tocTitle )">
                  <!-- Populated dynamically from article headings + Bootstrap 6 ScrollSpy -->
                </nav>
              </div>
            </div>
          </dialog>
        </aside>
#end
      </div>
    </div>

#if( $enableSearch )
    <!-- Native Bootstrap 6 Search Dialog (<dialog class="dialog">) -->
    <dialog class="dialog supa-search-dialog" id="supaSearchDialog" aria-labelledby="supaSearchDialogTitle">
      <div class="dialog-header supa-search-dialog-header">
        <div class="supa-search-input-wrapper">
          <svg class="supa-search-modal-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search"
                 id="supaSearchInput"
                 class="supa-search-input"
                 placeholder="Search documentation..."
                 autocomplete="off"
                 aria-label="Search documentation" />
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close search"></button>
      </div>
      <div class="dialog-body supa-search-dialog-body">
        <div id="supaSearchStatus" class="supa-search-status" aria-live="polite">
          Type to search navigation, headings, and site pages.
        </div>
        <div id="supaSearchResults" class="supa-search-results" role="listbox" aria-label="Search results"></div>
      </div>
      <div class="dialog-footer supa-search-dialog-footer">
        <span class="supa-search-hint"><kbd>&#x2191;</kbd> <kbd>&#x2193;</kbd> to navigate</span>
        <span class="supa-search-hint"><kbd>&#x21B5;</kbd> to select</span>
        <span class="supa-search-hint"><kbd>Esc</kbd> to close</span>
      </div>
    </dialog>
#end

    <script type="module" src="$relativePath/js/supa-maven-skin.min.js"></script>
  </body>
</html>
