<!DOCTYPE html>
#parse( "site-macros.vm" )
##
## Read <custom><supaSkin>...</supaSkin></custom> (or legacy <furoSkin>) configuration with sensible defaults
#if( $site.getCustomChild( 'supaSkin' ) )
#set( $skinCfg = 'supaSkin' )
#else
#set( $skinCfg = 'furoSkin' )
#end
#set( $defaultTheme = $site.getCustomValue( "${skinCfg}.defaultTheme", 'auto' ) )
#set( $colorScheme = $site.getCustomValue( "${skinCfg}.colorScheme", 'furo' ) )
#set( $colorSchemeSelector = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.colorSchemeSelector", 'true' ) ) )
#set( $sidebarHideName = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.sidebarHideName", 'false' ) ) )
#set( $lightLogo = $site.getCustomValue( "${skinCfg}.lightLogo", '' ) )
#set( $darkLogo = $site.getCustomValue( "${skinCfg}.darkLogo", '' ) )
#set( $announcement = $site.getCustomValue( "${skinCfg}.announcement", '' ) )
#set( $sourceRepo = $site.getCustomValue( "${skinCfg}.sourceRepository", '' ) )
#set( $sourceBranch = $site.getCustomValue( "${skinCfg}.sourceBranch", 'main' ) )
#set( $sourceDir = $site.getCustomValue( "${skinCfg}.sourceDirectory", 'src/site' ) )
#set( $sourceEditBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.sourceEditButton", 'true' ) ) )
#set( $sourceViewBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.sourceViewButton", 'true' ) ) )
#set( $showBreadcrumb = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.breadcrumb", 'true' ) ) )
#set( $tocSidebar = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.tocSidebar", 'true' ) ) )
#set( $tocTitle = $site.getCustomValue( "${skinCfg}.tocTitle", 'On this page' ) )
#set( $tocMaxDepth = $convert.toNumber( $site.getCustomValue( "${skinCfg}.tocMaxDepth", '4' ) ) )
#set( $prevNextBtns = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.prevNextButtons", 'true' ) ) )
#set( $sidebarCollapseDepth = $convert.toNumber( $site.getCustomValue( "${skinCfg}.sidebarCollapseDepth", '1' ) ) )
#set( $footerTimestamp = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.footerTimestamp", 'true' ) ) )
#set( $footerVersion = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.footerVersion", 'true' ) ) )
#set( $copyCodeBtn = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.copyCodeButton", 'true' ) ) )
#set( $syntaxHighlighting = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.syntaxHighlighting", 'true' ) ) )
#set( $headingPermalinks = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.headingPermalinks", 'true' ) ) )
#set( $permalinkSymbol = $site.getCustomValue( "${skinCfg}.headingPermalinkSymbol", '#' ) )
#set( $enableSearch = $convert.toBoolean( $site.getCustomValue( "${skinCfg}.search", 'true' ) ) )
#set( $mermaidMode = $site.getCustomValue( "${skinCfg}.mermaid", 'auto' ) )
#set( $mermaidCdnUrl = $site.getCustomValue( "${skinCfg}.mermaidCdnUrl", 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs' ) )
#set( $katexMode = $site.getCustomValue( "${skinCfg}.katex", 'auto' ) )
#set( $katexCssCdnUrl = $site.getCustomValue( "${skinCfg}.katexCssCdnUrl", 'https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css' ) )
#set( $katexJsCdnUrl = $site.getCustomValue( "${skinCfg}.katexJsCdnUrl", 'https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.mjs' ) )
##
<!--
 | Generated by #generatedBy()##
#if( $docRenderingContext && ( $docRenderingContext.generator || $docRenderingContext.doxiaSource ) ) from##
#if( $docRenderingContext.generator ) $docRenderingContext.generator#end##
#if( $docRenderingContext.doxiaSource ) $docRenderingContext.doxiaSourcePath#end##
#end

 | Rendered using Supa Maven Skin @project.version@ (Bootstrap 6.0.0-alpha.1)
-->
<html lang="$locale.language"
      data-furo-default-theme="$esc.html( $defaultTheme )"
      data-furo-default-palette="$esc.html( $colorScheme )"
      data-furo-palette="$esc.html( $colorScheme )"
      data-furo-project-version="#if( $project && $project.version )$esc.html( $project.version )#else 0.1.0#end"
      data-furo-relative-path="$relativePath">
  <head>
    <meta charset="${outputEncoding}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="#generatedBy()" />
#foreach( $author in $authors )
    <meta name="author" content="$esc.html( $author )" />
#end
#if( $dateCreation )
    <meta name="date" content="$esc.html( $dateCreation )" />
#end
    <title>$esc.html( $title )</title>

    <!-- Early Theme & Palette Initialization (Prevents FOUC with Bootstrap 6 color-scheme & data-furo-palette) -->
    <script>
      (function () {
        var root = document.documentElement;
        var themeKey = 'furo-theme';
        var paletteKey = 'furo-palette';
        var defaultMode = root.getAttribute('data-furo-default-theme') || 'auto';
        var defaultPalette = root.getAttribute('data-furo-default-palette') || 'furo';
        var storedMode = null;
        var storedPalette = null;
        try {
          storedMode = localStorage.getItem(themeKey);
          storedPalette = localStorage.getItem(paletteKey);
        } catch (e) {}
        var mode = (storedMode === 'light' || storedMode === 'dark' || storedMode === 'auto')
          ? storedMode
          : defaultMode;
        root.setAttribute('data-furo-theme-mode', mode);
        if (mode === 'light' || mode === 'dark') {
          root.setAttribute('data-bs-theme', mode);
          root.setAttribute('data-furo-resolved-theme', mode);
        } else {
          root.removeAttribute('data-bs-theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.setAttribute('data-furo-resolved-theme', prefersDark ? 'dark' : 'light');
        }
        var validPalettes = {
          'furo': true,
          'bootstrap': true,
          'modus': true,
          'modus-tinted': true,
          'modus-deuteranopia': true,
          'modus-tritanopia': true
        };
        var palette = (storedPalette && validPalettes[storedPalette]) ? storedPalette : defaultPalette;
        root.setAttribute('data-furo-palette', palette);
        if (storedPalette && validPalettes[storedPalette]) {
          root.setAttribute('data-furo-palette-locked', 'true');
        }
      })();
    </script>

    <link rel="stylesheet" href="$relativePath/css/supa-maven-skin.min.css" />
    <link rel="stylesheet" href="$relativePath/css/site.css" onerror="this.remove()" />
##
## Inject Furo-style <lightCssVariables> and <darkCssVariables> overrides from site.xml
#set( $lightVars = $site.getCustomChild( "${skinCfg}.lightCssVariables" ) )
#set( $darkVars = $site.getCustomChild( "${skinCfg}.darkCssVariables" ) )
#if( ( $lightVars && $lightVars.getChildren().size() > 0 ) || ( $darkVars && $darkVars.getChildren().size() > 0 ) )
    <style id="furo-custom-css-variables">
#if( $lightVars && $lightVars.getChildren().size() > 0 )
      html:root, html[data-bs-theme="light"], html[data-furo-palette] {
#foreach( $child in $lightVars.getChildren() )
        --$child.getName(): $child.getValue();
#end
      }
#end
#if( $darkVars && $darkVars.getChildren().size() > 0 )
      html[data-bs-theme="dark"], html[data-furo-palette][data-bs-theme="dark"] {
#foreach( $child in $darkVars.getChildren() )
        --$child.getName(): $child.getValue();
#end
      }
      @media (prefers-color-scheme: dark) {
        html:root:not([data-bs-theme="light"]), html[data-furo-palette]:not([data-bs-theme="light"]) {
#foreach( $child in $darkVars.getChildren() )
          --$child.getName(): $child.getValue();
#end
        }
      }
#end
    </style>
#end
#if( $site.body.head )
    $render.eval( $site.body.head )
#end
#if( $headContent )
    $headContent
#end
  </head>
  <body class="furo-body"
        data-furo-toc="$tocSidebar"
        data-furo-toc-max-depth="$tocMaxDepth"
        data-furo-copy-code="$copyCodeBtn"
        data-furo-syntax-highlight="$syntaxHighlighting"
        data-furo-permalinks="$headingPermalinks"
        data-furo-permalink-symbol="$esc.html( $permalinkSymbol )"
        data-furo-search="$enableSearch"
        data-furo-mermaid="$esc.html( $mermaidMode )"
        data-furo-mermaid-url="$esc.html( $mermaidCdnUrl )"
        data-furo-katex="$esc.html( $katexMode )"
        data-furo-katex-css-url="$esc.html( $katexCssCdnUrl )"
        data-furo-katex-js-url="$esc.html( $katexJsCdnUrl )">

    <a class="furo-skip-link visually-hidden-focusable" href="#furo-main-content">Skip to content</a>

#if( $announcement && $announcement != "" )
    <!-- Optional Top Announcement Banner -->
    <div class="furo-announcement" role="region" aria-label="Announcement">
      <div class="furo-announcement-content">$announcement</div>
    </div>
#end

    <!-- Mobile / Tablet Sticky Header Bar (< lg) -->
    <header class="furo-mobile-header lg:d-none">
      <div class="furo-mobile-header-left">
        <button type="button"
                class="furo-icon-btn"
                data-bs-toggle="drawer"
                data-bs-target="#furoSidebarDrawer"
                aria-controls="furoSidebarDrawer"
                aria-label="Toggle navigation sidebar">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="furo-mobile-header-center">
        <a class="furo-mobile-brand" href="$relativePath/index.html">
#if( $site.name )
          $esc.html( $site.name )
#elseif( $project && $project.name )
          $esc.html( $project.name )
#else
          Documentation
#end
        </a>
      </div>
      <div class="furo-mobile-header-right">
#if( $colorSchemeSelector )
#furoPalettePicker( "" "bottom-end" )
#end
        <button type="button"
                class="furo-icon-btn furo-theme-toggle"
                data-furo-theme-toggle="true"
                aria-label="Toggle Light / Dark / Auto color theme"
                title="Toggle color theme (Light / Dark / Auto)">
          <svg class="furo-theme-icon furo-theme-icon-light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="furo-theme-icon furo-theme-icon-dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="furo-theme-icon furo-theme-icon-auto" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"></path></svg>
        </button>
#if( $enableSearch )
        <button type="button"
                class="furo-icon-btn"
                data-bs-toggle="dialog"
                data-bs-target="#furoSearchDialog"
                aria-label="Search documentation">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
#end
#if( $tocSidebar )
        <button type="button"
                class="furo-icon-btn furo-toc-drawer-trigger"
                data-bs-toggle="drawer"
                data-bs-target="#furoTocDrawer"
                aria-controls="furoTocDrawer"
                aria-label="Toggle table of contents">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
#end
      </div>
    </header>

    <!-- Main 3-Column Furo Page Grid -->
    <div class="furo-page">
      <!-- 1. Left Navigation Sidebar (Inline on lg+, Bootstrap 6 Drawer below lg) -->
      <aside class="furo-sidebar-column" aria-label="Primary navigation">
        <dialog class="lg:drawer drawer-start drawer-sheet furo-sidebar-drawer"
                id="furoSidebarDrawer"
                tabindex="-1"
                aria-labelledby="furoSidebarBrandText">
          <div class="drawer-header lg:d-none furo-drawer-header">
            <span class="drawer-title fw-semibold">Navigation</span>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close navigation"></button>
          </div>

          <div class="drawer-body furo-sidebar-container">
            <!-- Brand / Logo Area -->
#set( $brandHref = "$relativePath/index.html" )
#if( $site.bannerLeft && $site.bannerLeft.href )
#furoResolveHref( $site.bannerLeft.href )
#set( $brandHref = $resolvedHref )
#end
            <a class="furo-sidebar-brand" href="$brandHref">
#if( $lightLogo != "" && $darkLogo != "" )
#furoResolveHref( $lightLogo )
#set( $lightLogoUrl = $resolvedHref )
#furoResolveHref( $darkLogo )
#set( $darkLogoUrl = $resolvedHref )
              <div class="furo-sidebar-logo-container">
                <img class="furo-sidebar-logo only-light" src="$lightLogoUrl" alt="Light Logo" />
                <img class="furo-sidebar-logo only-dark" src="$darkLogoUrl" alt="Dark Logo" />
              </div>
#elseif( $lightLogo != "" )
#furoResolveHref( $lightLogo )
              <div class="furo-sidebar-logo-container">
                <img class="furo-sidebar-logo" src="$resolvedHref" alt="Logo" />
              </div>
#elseif( $site.bannerLeft && $site.bannerLeft.image && $site.bannerLeft.image.src )
#furoResolveHref( $site.bannerLeft.image.src )
              <div class="furo-sidebar-logo-container">
                <img class="furo-sidebar-logo" src="$resolvedHref" alt="#if( $site.bannerLeft.name )$esc.html( $site.bannerLeft.name )#else Logo#end" />
              </div>
#end
#if( !$sidebarHideName )
              <div class="furo-brand-meta">
                <span class="furo-brand-text" id="furoSidebarBrandText">
#if( $site.bannerLeft && $site.bannerLeft.name )
                  $esc.html( $site.bannerLeft.name )
#elseif( $site.name )
                  $esc.html( $site.name )
#elseif( $project && $project.name )
                  $esc.html( $project.name )
#else
                  Documentation
#end
                </span>
#if( $project && $project.version && $footerVersion )
                <span class="furo-version-badge badge theme-secondary">$esc.html( $project.version )</span>
#end
              </div>
#end
            </a>

#if( $enableSearch )
            <!-- Sidebar Search Trigger -->
            <div class="furo-sidebar-search">
              <button type="button"
                      class="furo-search-trigger"
                      data-bs-toggle="dialog"
                      data-bs-target="#furoSearchDialog"
                      aria-label="Search documentation (Press / or Command+K)">
                <svg class="furo-search-trigger-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span class="furo-search-trigger-placeholder">Search</span>
                <kbd class="furo-search-kbd" aria-hidden="true">&#x2318;K</kbd>
              </button>
            </div>
#end

            <!-- Hierarchical Site Navigation Tree -->
            <nav class="furo-sidebar-tree" aria-label="Site navigation">
#furoSidebarMenus( $site.body.menus $sidebarCollapseDepth )
            </nav>

            <!-- Mobile / Tablet Drawer Appearance Footer (< lg) -->
            <div class="furo-sidebar-footer lg:d-none">
#if( $colorSchemeSelector )
              <div class="furo-sidebar-footer-group">
                <span class="furo-sidebar-footer-label">Color scheme</span>
                <div class="furo-sidebar-footer-controls">
#furoPalettePicker( "" "top-start" )
                  <button type="button"
                          class="furo-icon-btn furo-theme-toggle"
                          data-furo-theme-toggle="true"
                          aria-label="Toggle Light / Dark / Auto color theme"
                          title="Toggle color theme (Light / Dark / Auto)">
                    <svg class="furo-theme-icon furo-theme-icon-light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="furo-theme-icon furo-theme-icon-dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                    <svg class="furo-theme-icon furo-theme-icon-auto" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"></path></svg>
                  </button>
                </div>
              </div>
#end
            </div>
          </div>
        </dialog>
      </aside>

      <!-- 2. Center Main Content Area -->
      <div class="furo-main">
        <div class="furo-content">
          <div class="furo-article-container">
            <!-- Top Content Utility Bar (Breadcrumbs, Source Links, Palette Picker, Theme Toggle, Tablet TOC Button) -->
            <div class="furo-content-header not-prose">
              <div class="furo-header-left">
#if( $showBreadcrumb )
                <nav aria-label="Breadcrumb" class="furo-breadcrumb-nav">
                  <ol class="breadcrumb mb-0 furo-breadcrumb">
                    <li class="breadcrumb-item">
                      <a href="$relativePath/index.html">#if( $site.name )$esc.html( $site.name )#elseif( $project && $project.name )$esc.html( $project.name )#else Home#end</a>
                    </li>
#if( $site.body.breadcrumbs && $site.body.breadcrumbs.size() > 0 )
#foreach( $crumb in $site.body.breadcrumbs )
                    <li class="breadcrumb-item">
#if( $crumb.href )
                      <a href="$crumb.href">$esc.html( $crumb.name )</a>
#else
                      <span>$esc.html( $crumb.name )</span>
#end
                    </li>
#end
#end
#if( $shortTitle )
                    <li class="breadcrumb-item active" aria-current="page">
                      $esc.html( $shortTitle )
                    </li>
#end
                  </ol>
                </nav>
#end
              </div>

              <div class="furo-header-right">
#if( $sourceRepo && $sourceRepo != "" && $docRenderingContext && $docRenderingContext.doxiaSource )
#set( $doxiaPath = $docRenderingContext.doxiaSourcePath.replace( '\\', '/' ) )
#if( $sourceDir != "" && !$doxiaPath.startsWith( $sourceDir ) )
#set( $repoFilePath = "$sourceDir/$doxiaPath" )
#else
#set( $repoFilePath = $doxiaPath )
#end
#if( $sourceViewBtn )
                <a class="furo-icon-btn"
                   href="${sourceRepo}/blob/${sourceBranch}/${repoFilePath}"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="View page source"
                   aria-label="View page source">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                </a>
#end
#if( $sourceEditBtn )
                <a class="furo-icon-btn"
                   href="${sourceRepo}/edit/${sourceBranch}/${repoFilePath}"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Edit this page"
                   aria-label="Edit this page">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </a>
#end
#end
#if( $colorSchemeSelector )
#furoPalettePicker( "d-none lg:d-inline-flex" "bottom-end" )
#end
                <button type="button"
                        class="furo-icon-btn furo-theme-toggle d-none lg:d-inline-flex"
                        data-furo-theme-toggle="true"
                        aria-label="Toggle Light / Dark / Auto color theme"
                        title="Toggle color theme (Light / Dark / Auto)">
                  <svg class="furo-theme-icon furo-theme-icon-light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                  <svg class="furo-theme-icon furo-theme-icon-dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                  <svg class="furo-theme-icon furo-theme-icon-auto" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"></path></svg>
                </button>
#if( $tocSidebar )
                <button type="button"
                        class="furo-icon-btn furo-toc-drawer-trigger d-none lg:d-inline-flex xl:d-none"
                        data-bs-toggle="drawer"
                        data-bs-target="#furoTocDrawer"
                        aria-controls="furoTocDrawer"
                        aria-label="Toggle table of contents"
                        title="$esc.html( $tocTitle )">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="9" y1="12" x2="21" y2="12"></line>
                    <line x1="6" y1="18" x2="21" y2="18"></line>
                  </svg>
                </button>
#end
              </div>
            </div>

            <!-- Main Article Prose Content -->
            <main id="furo-main-content" class="furo-article prose" role="main">
              $bodyContent
            </main>

#if( $prevNextBtns )
            <!-- Previous / Next Page Navigation Cards -->
#furoPrevNextNavigation( $site.body.menus )
#end

            <!-- Page Footer -->
            <footer class="furo-footer not-prose">
              <div class="furo-footer-meta">
                <div class="furo-footer-left">
#if( $site.body.footer )
                  <div class="furo-custom-footer">$render.eval( $site.body.footer )</div>
#else
                  <div class="furo-copyright">
                    Copyright &#169; #furoCopyright().
                  </div>
#end
                  <div class="furo-built-with">
                    Built with <a href="https://maven.apache.org/plugins/maven-site-plugin/">Maven Site</a> and <a href="https://github.com/mepcotterell/supa-maven-skin">Supa Maven Skin</a> (Bootstrap 6).
#if( $footerTimestamp )
#if( $date )
                    <span class="furo-last-updated">Last updated on $date.get( 'yyyy-MM-dd' ).</span>
#elseif( $dateFormat && $currentDate )
                    <span class="furo-last-updated">Last updated on $dateFormat.format( $currentDate ).</span>
#end
#end
                  </div>
                </div>

#set( $navIcons = $site.getCustomChild( "${skinCfg}.navIcons" ) )
                <div class="furo-footer-right">
#if( $navIcons && $navIcons.getChildren().size() > 0 )
                  <div class="furo-footer-icons">
#foreach( $iconNode in $navIcons.getChildren() )
#set( $iconHref = $iconNode.getChild( 'href' ).getValue() )
#set( $iconTitle = $iconNode.getChild( 'title' ).getValue() )
#set( $iconHtml = $iconNode.getChild( 'html' ).getValue() )
#if( $iconHref )
                    <a class="furo-footer-icon-link" href="$iconHref"#if( $iconTitle ) title="$esc.html( $iconTitle )" aria-label="$esc.html( $iconTitle )"#end target="_blank" rel="noopener noreferrer">
#if( $iconHtml )
                      $iconHtml
#elseif( $iconTitle )
                      $esc.html( $iconTitle )
#end
                    </a>
#end
#end
                  </div>
#end
                </div>
              </div>
            </footer>
          </div>
        </div>

#if( $tocSidebar )
        <!-- 3. Right Table of Contents Sidebar ("On this page" — Inline on xl+, Bootstrap 6 Drawer below xl) -->
        <aside class="furo-toc-column" aria-label="On this page">
          <dialog class="xl:drawer drawer-end drawer-sheet furo-toc-drawer"
                  id="furoTocDrawer"
                  tabindex="-1"
                  aria-labelledby="furoTocDrawerTitle">
            <div class="drawer-header xl:d-none furo-drawer-header">
              <span class="drawer-title fw-semibold" id="furoTocDrawerTitle">$esc.html( $tocTitle )</span>
              <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close table of contents"></button>
            </div>
            <div class="drawer-body furo-toc-container">
              <div class="furo-toc-title">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="9" y1="12" x2="21" y2="12"></line>
                  <line x1="6" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>$esc.html( $tocTitle )</span>
              </div>
              <div class="furo-toc-scroll">
                <nav id="furoTocNav" class="nav flex-column furo-toc-nav" aria-label="$esc.html( $tocTitle )">
                  <!-- Populated dynamically from article headings + Bootstrap 6 ScrollSpy -->
                </nav>
              </div>
            </div>
          </dialog>
        </aside>
#end
      </div>
    </div>

#if( $enableSearch )
    <!-- Native Bootstrap 6 Search Dialog (<dialog class="dialog">) -->
    <dialog class="dialog furo-search-dialog" id="furoSearchDialog" aria-labelledby="furoSearchDialogTitle">
      <div class="dialog-header furo-search-dialog-header">
        <div class="furo-search-input-wrapper">
          <svg class="furo-search-modal-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search"
                 id="furoSearchInput"
                 class="furo-search-input"
                 placeholder="Search documentation..."
                 autocomplete="off"
                 aria-label="Search documentation" />
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close search"></button>
      </div>
      <div class="dialog-body furo-search-dialog-body">
        <div id="furoSearchStatus" class="furo-search-status" aria-live="polite">
          Type to search navigation, headings, and site pages.
        </div>
        <div id="furoSearchResults" class="furo-search-results" role="listbox" aria-label="Search results"></div>
      </div>
      <div class="dialog-footer furo-search-dialog-footer">
        <span class="furo-search-hint"><kbd>&#x2191;</kbd> <kbd>&#x2193;</kbd> to navigate</span>
        <span class="furo-search-hint"><kbd>&#x21B5;</kbd> to select</span>
        <span class="furo-search-hint"><kbd>Esc</kbd> to close</span>
      </div>
    </dialog>
#end

    <script type="module" src="$relativePath/js/supa-maven-skin.min.js"></script>
  </body>
</html>
