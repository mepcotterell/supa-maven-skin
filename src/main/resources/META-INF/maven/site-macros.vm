##
## Render Furo-styled Previous / Next navigation cards at bottom of article
#macro( furoPrevNextNavigation $menus )
#set( $flatNavItems = [] )
#if( $menus )
#foreach( $menu in $menus )
#foreach( $item in $menu.items )
#furoCollectNavItem( $item $flatNavItems )
#end
#end
#end
#set( $currentIndex = -1 )
#set( $idx = 0 )
#foreach( $navItem in $flatNavItems )
#if( $currentIndex == -1 && $alignedFileName == $navItem.href )
#set( $currentIndex = $idx )
#end
#set( $idx = $idx + 1 )
#end
#set( $prevItem = false )
#set( $nextItem = false )
#if( $currentIndex > 0 )
#set( $prevIndex = $currentIndex - 1 )
#set( $prevItem = $flatNavItems.get( $prevIndex ) )
#end
#set( $nextIndex = $currentIndex + 1 )
#if( $currentIndex >= 0 && $nextIndex < $flatNavItems.size() )
#set( $nextItem = $flatNavItems.get( $nextIndex ) )
#end
#if( $prevItem || $nextItem )
    <nav class="furo-related-pages not-prose" aria-label="Page navigation">
#if( $prevItem )
      <a class="furo-prev-page" href="$prevItem.href">
        <svg class="furo-related-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <div class="furo-page-info">
          <div class="furo-context">
            <span>Previous</span>
          </div>
          <div class="furo-title">$esc.html( $prevItem.name )</div>
        </div>
      </a>
#end
#if( $nextItem )
      <a class="furo-next-page" href="$nextItem.href">
        <div class="furo-page-info">
          <div class="furo-context">
            <span>Next</span>
          </div>
          <div class="furo-title">$esc.html( $nextItem.name )</div>
        </div>
        <svg class="furo-related-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
#end
    </nav>
#end
#end
##
## Render Accessible Color Scheme Menu Picker (Bootstrap 6 .menu)
#macro( furoPalettePicker $extraClasses $placement )
        <div class="furo-palette-picker#if( $extraClasses && $extraClasses != '' ) $extraClasses#end">
          <button type="button"
                  class="furo-palette-btn"
                  data-bs-toggle="menu"
                  data-bs-placement="#if( $placement && $placement != '' )$placement#else bottom-end#end"
                  data-bs-title="Select accessible color scheme (WCAG 2.2 AA / AAA)"
                  data-furo-palette-trigger="true"
                  aria-expanded="false"
                  aria-label="Select accessible color scheme">
            <span class="furo-palette-btn-label" data-furo-palette-label="true">Furo (AA)</span>
            <svg class="furo-palette-picker-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 6 8 10 12 6"></polyline></svg>
          </button>
          <div class="menu furo-palette-menu" role="menu" aria-label="Accessible color schemes">
            <h6 class="menu-header">WCAG 2.2 AA Standard</h6>
            <button type="button" class="menu-item selected" role="menuitemradio" aria-checked="true" data-furo-palette-option="furo">
              <span class="menu-item-content">Furo (AA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-furo-palette-option="bootstrap">
              <span class="menu-item-content">Bootstrap 6 (AA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <hr class="menu-divider" />
            <h6 class="menu-header">WCAG 2.2 AAA High Contrast</h6>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-furo-palette-option="modus">
              <span class="menu-item-content">Modus (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-furo-palette-option="modus-tinted">
              <span class="menu-item-content">Modus Tinted (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-furo-palette-option="modus-deuteranopia">
              <span class="menu-item-content">Modus Deuteranopia (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-furo-palette-option="modus-tritanopia">
              <span class="menu-item-content">Modus Tritanopia (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
          </div>
        </div>
#end
