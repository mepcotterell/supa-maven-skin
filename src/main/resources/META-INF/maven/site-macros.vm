#macro( bsAlert $theme $title $body $dismissible )
<div class="alert theme-$esc.html( $theme ) not-prose my-3" role="alert">
  <div class="flex-grow-1">
#if( $title && $title != "" )
    <div class="alert-heading fw-semibold mb-1">$esc.html( $title )</div>
#end
    <div>$body</div>
  </div>
#if( $dismissible )
## A .md.vm page is evaluated before site.vm runs, so the labels may not be built yet
#if( !$supaLabels )
#supaBuildLabels()
#end
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="$esc.html( $supaLabels.alertDismiss )"></button>
#end
</div>
#end
