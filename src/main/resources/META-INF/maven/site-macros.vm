##
## Render Copyright statement
#macro( furoCopyright )
#if( $project )
#set( $currentYear = "" )
#if( $date && $date.year )
#set( $currentYear = "${date.year}" )
#elseif( $currentDate && $currentDate.year )
#set( $currentYearInt = ${currentDate.year} + 1900 )
#set( $currentYear = "${currentYearInt}" )
#end
#if( ${project.inceptionYear} && $currentYear != "" && ( ${project.inceptionYear} != $currentYear ) )
${project.inceptionYear}&#x2013;${currentYear}##
#elseif( ${project.inceptionYear} )
${project.inceptionYear}##
#elseif( $currentYear != "" )
${currentYear}##
#end
#if( ${project.organization} )
#if( ${project.organization.name} && ${project.organization.url} )
 <a href="$project.organization.url">$esc.html( ${project.organization.name} )</a>##
#elseif( ${project.organization.name} )
 $esc.html( ${project.organization.name} )##
#end
#end
#end
#end
##
## Bootstrap 6 Velocity Helper Macros for Site Authors (.md.vm / .apt.vm / .xhtml.vm)
#macro( bsAlert $theme $title $body $dismissible )
<div class="alert theme-$esc.html( $theme ) not-prose my-3" role="alert">
  <div class="flex-grow-1">
#if( $title && $title != "" )
    <div class="alert-heading fw-semibold mb-1">$esc.html( $title )</div>
#end
    <div>$body</div>
  </div>
#if( $dismissible )
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
#end
</div>
#end
##
#macro( bsBadge $theme $variant $text )
<span class="badge#if( $variant && $variant != '' ) badge-$esc.html( $variant )#end theme-$esc.html( $theme ) not-prose">$esc.html( $text )</span>##
#end
##
#macro( bsCard $title $subtitle $body $footer )
<div class="card not-prose my-3">
  <div class="card-body">
#if( $title && $title != "" )
    <div class="card-title h5">$esc.html( $title )</div>
#end
#if( $subtitle && $subtitle != "" )
    <div class="card-subtitle h6 mb-2 text-body-secondary">$esc.html( $subtitle )</div>
#end
    <div class="card-text">$body</div>
  </div>
#if( $footer && $footer != "" )
  <div class="card-footer text-body-secondary">$footer</div>
#end
</div>
#end
