#elseif( $menuItem.items && $menuItem.items.size() > 0 )
#foreach( $subItem in $menuItem.items )
#supaMenuItemHref( $subItem.href )
#if( $itemIsCurrent )
#set( $hasActive = true )
#elseif( $subItem.items && $subItem.items.size() > 0 )
#foreach( $deepItem in $subItem.items )
#supaMenuItemHref( $deepItem.href )
