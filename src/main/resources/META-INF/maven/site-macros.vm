##
## Render Accessible Color Scheme Menu Picker (Bootstrap 6 .menu)
#macro( supaPalettePicker $extraClasses $placement )
        <div class="supa-palette-picker#if( $extraClasses && $extraClasses != '' ) $extraClasses#end">
          <button type="button"
                  class="supa-palette-btn"
                  data-bs-toggle="menu"
                  data-bs-placement="#if( $placement && $placement != '' )$placement#else bottom-end#end"
                  data-bs-title="Select accessible color scheme (WCAG 2.2 AA / AAA)"
                  data-supa-palette-trigger="true"
                  aria-expanded="false"
                  aria-label="Select accessible color scheme">
            <span class="supa-palette-btn-label" data-supa-palette-label="true">Furo (AA)</span>
            <svg class="supa-palette-picker-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 6 8 10 12 6"></polyline></svg>
          </button>
          <div class="menu supa-palette-menu" role="menu" aria-label="Accessible color schemes">
            <h6 class="menu-header">WCAG 2.2 AA Standard</h6>
            <button type="button" class="menu-item selected" role="menuitemradio" aria-checked="true" data-supa-palette-option="furo">
              <span class="menu-item-content">Furo (AA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-palette-option="bootstrap">
              <span class="menu-item-content">Bootstrap 6 (AA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <hr class="menu-divider" />
            <h6 class="menu-header">WCAG 2.2 AAA High Contrast</h6>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-palette-option="modus">
              <span class="menu-item-content">Modus (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-palette-option="modus-tinted">
              <span class="menu-item-content">Modus Tinted (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-palette-option="modus-deuteranopia">
              <span class="menu-item-content">Modus Deuteranopia (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-palette-option="modus-tritanopia">
              <span class="menu-item-content">Modus Tritanopia (AAA)</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
          </div>
        </div>
#end
##
## Render Theme Mode Menu Picker (Bootstrap 6 .menu with mutually exclusive Light / Dark / Auto choices)
#macro( supaThemeToggle $extraClasses $placement )
        <div class="supa-theme-toggle#if( $extraClasses && $extraClasses != '' ) $extraClasses#end">
          <button type="button"
                  class="supa-icon-btn supa-theme-toggle-btn"
                  data-bs-toggle="menu"
                  data-bs-placement="#if( $placement && $placement != '' )$placement#else bottom-end#end"
                  data-bs-title="Select color theme (Light / Dark / Auto)"
                  data-supa-theme-trigger="true"
                  aria-expanded="false"
                  aria-label="Select color theme (Light / Dark / Auto)">
            <i class="bi bi-sun supa-theme-icon supa-theme-icon-light" aria-hidden="true"></i>
            <i class="bi bi-moon-stars supa-theme-icon supa-theme-icon-dark" aria-hidden="true"></i>
            <i class="bi bi-circle-half supa-theme-icon supa-theme-icon-auto" aria-hidden="true"></i>
          </button>
          <div class="menu supa-theme-menu" role="menu" aria-label="Color theme">
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-theme-option="light">
              <i class="bi bi-sun menu-item-icon" aria-hidden="true"></i>
              <span class="menu-item-content">Light</span>
              <i class="bi bi-check2 menu-item-check" aria-hidden="true"></i>
            </button>
            <button type="button" class="menu-item" role="menuitemradio" aria-checked="false" data-supa-theme-option="dark">
              <i class="bi bi-moon-stars menu-item-icon" aria-hidden="true"></i>
              <span class="menu-item-content">Dark</span>
              <i class="bi bi-check2 menu-item-check" aria-hidden="true"></i>
            </button>
            <button type="button" class="menu-item selected" role="menuitemradio" aria-checked="true" data-supa-theme-option="auto">
              <i class="bi bi-circle-half menu-item-icon" aria-hidden="true"></i>
              <span class="menu-item-content">Auto</span>
              <i class="bi bi-check2 menu-item-check" aria-hidden="true"></i>
            </button>
          </div>
        </div>
#end
##
## Render Copyright statement
#macro( supaCopyright )
#if( $project )
#set( $currentYear = "" )
#if( $date && $date.year )
#set( $currentYear = "${date.year}" )
#elseif( $currentDate && $currentDate.year )
#set( $currentYearInt = ${currentDate.year} + 1900 )
#set( $currentYear = "${currentYearInt}" )
#end
#if( ${project.inceptionYear} && $currentYear != "" && ( ${project.inceptionYear} != $currentYear ) )
${project.inceptionYear}&#x2013;${currentYear}##
#elseif( ${project.inceptionYear} )
${project.inceptionYear}##
#elseif( $currentYear != "" )
${currentYear}##
#end
#if( ${project.organization} )
#if( ${project.organization.name} && ${project.organization.url} )
 <a href="$project.organization.url">$esc.html( ${project.organization.name} )</a>##
#elseif( ${project.organization.name} )
 $esc.html( ${project.organization.name} )##
#end
#end
#end
#end
##
## Bootstrap Icons & Bootstrap 6 Velocity Helper Macros for Site Authors (.md.vm / .apt.vm / .xhtml.vm)
#macro( bi $name $extraClasses $ariaLabel )
<i class="bi bi-$esc.html( $name )#if( $extraClasses && $extraClasses != '' ) $esc.html( $extraClasses )#end"#if( $ariaLabel && $ariaLabel != '' ) role="img" aria-label="$esc.html( $ariaLabel )"#else aria-hidden="true"#end></i>##
#end
##
#macro( bsAlert $theme $title $body $dismissible )
<div class="alert theme-$esc.html( $theme ) not-prose my-3" role="alert">
  <div class="flex-grow-1">
#if( $title && $title != "" )
    <div class="alert-heading fw-semibold mb-1">$esc.html( $title )</div>
#end
    <div>$body</div>
  </div>
#if( $dismissible )
  <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
#end
</div>
#end
##
#macro( bsBadge $theme $variant $text )
<span class="badge#if( $variant && $variant != '' ) badge-$esc.html( $variant )#end theme-$esc.html( $theme ) not-prose">$esc.html( $text )</span>##
#end
##
#macro( bsCard $title $subtitle $body $footer )
<div class="card not-prose my-3">
  <div class="card-body">
#if( $title && $title != "" )
    <div class="card-title h5">$esc.html( $title )</div>
#end
#if( $subtitle && $subtitle != "" )
    <div class="card-subtitle h6 mb-2 text-body-secondary">$esc.html( $subtitle )</div>
#end
    <div class="card-text">$body</div>
  </div>
#if( $footer && $footer != "" )
  <div class="card-footer text-body-secondary">$footer</div>
#end
</div>
#end
