##
## Resolve the configured <colorScheme> $palette into $paletteId and its short name $paletteName
## (SUPA_PALETTES shortLabel in theme.ts). An unknown ID falls back to furo, as theme.ts does. The
## picker and the drawer select both start on it, so before scripts run every control agrees.
## $supaPaletteNames maps every ID, in menu order, to its plain-text short name: the scheme's
## label followed by its WCAG level, which a site cannot change because the build audits it.
#macro( supaResolvePalette $palette )
#set( $supaPaletteNames = {} )
#set( $_ = $supaPaletteNames.put( 'furo', "$supaLabels.colorSchemeFuro (AA)" ) )
#set( $_ = $supaPaletteNames.put( 'bootstrap', "$supaLabels.colorSchemeBootstrap (AA)" ) )
#set( $_ = $supaPaletteNames.put( 'modus', "$supaLabels.colorSchemeModus (AAA)" ) )
#set( $_ = $supaPaletteNames.put( 'modus-tinted', "$supaLabels.colorSchemeModusTinted (AAA)" ) )
#set( $_ = $supaPaletteNames.put( 'modus-deuteranopia', "$supaLabels.colorSchemeModusDeuteranopia (AAA)" ) )
#set( $_ = $supaPaletteNames.put( 'modus-tritanopia', "$supaLabels.colorSchemeModusTritanopia (AAA)" ) )
#if( $palette && $supaPaletteNames.containsKey( $palette ) )
#set( $paletteId = $palette )
#else
#set( $paletteId = 'furo' )
#end
#set( $paletteName = $supaPaletteNames.get( $paletteId ) )
#end
##
## Render Accessible Color Scheme Menu Picker (Bootstrap 6 .menu) for the configured <colorScheme>
## $palette. The trigger shows the scheme's short name, and its accessible name and tooltip contain
## it, so voice-control users can activate it by saying what they see (WCAG 2.5.3 Label in Name)
## before scripts run; theme.ts rewrites all three, and the checked item, on every change.
#macro( supaPalettePicker $extraClasses $placement $palette )
#supaResolvePalette( $palette )
#supaFillLabel( $esc.html( $supaLabels.colorSchemeTrigger ) 'name' $esc.html( $paletteName ) )
## A translated colorSchemeTrigger without {name} would drop the shown name, so append it (as
## theme.ts does) to keep the name containing the visible text
#if( !$supaFilled.contains( $esc.html( $paletteName ) ) )
#set( $supaFilled = "$supaFilled $esc.html( $paletteName )" )
#end
        <div class="supa-palette-picker#if( $extraClasses && $extraClasses != '' ) $extraClasses#end">
          <button type="button"
                  class="supa-palette-btn"
                  data-bs-toggle="menu"
                  data-bs-placement="#if( $placement && $placement != '' )$placement#else bottom-end#end"
                  data-bs-title="$supaFilled"
                  data-supa-palette-trigger="true"
                  aria-expanded="false"
                  aria-label="$supaFilled">
            <span class="supa-palette-btn-label" data-supa-palette-label="true">$esc.html( $paletteName )</span>
            <svg class="supa-palette-picker-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 6 8 10 12 6"></polyline></svg>
          </button>
## A role="menu" may own only menu items, groups, and separators (axe aria-required-children), and
## Bootstrap's Menu arrow-key navigation only walks items that are direct children of .menu, so the
## headers cannot move into role="group" wrappers. They stay visual dividers hidden from assistive
## technology; every option name already states its WCAG level, such as "Modus (AAA)".
          <div class="menu supa-palette-menu" role="menu" aria-label="$esc.html( $supaLabels.colorScheme )">
            <h6 class="menu-header" aria-hidden="true">$esc.html( $supaLabels.colorSchemeStandard )</h6>
#foreach( $supaOptionId in $supaPaletteNames.keySet() )
#if( $supaOptionId == 'modus' )
            <hr class="menu-divider" />
            <h6 class="menu-header" aria-hidden="true">$esc.html( $supaLabels.colorSchemeHighContrast )</h6>
#end
            <button type="button" class="menu-item#if( $paletteId == $supaOptionId ) selected#end" role="menuitemradio" aria-checked="#if( $paletteId == $supaOptionId )true#{else}false#end" data-supa-palette-option="$supaOptionId">
              <span class="menu-item-content">$esc.html( $supaPaletteNames.get( $supaOptionId ) )</span>
              <svg class="menu-item-check" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="2.5 8.5 6.5 12.5 13.5 4.5"></polyline></svg>
            </button>
#end
          </div>
        </div>
#end
##
## Render Accessible Color Scheme Native Select (sidebar drawer Appearance footer). Opened from the
## bottom of the drawer, the #supaPalettePicker .menu floats up over the nav tree and leaves slivers
## of the links under its edges tappable (axe target-size, WCAG 2.5.8), so a tap meant to dismiss it
## can follow a half-hidden link. The browser draws a native picker outside the page, so nothing is
## partly covered. theme.ts keeps every [data-supa-palette-select] in sync with the menus.
#macro( supaPaletteSelect $extraClasses $palette )
#supaResolvePalette( $palette )
        <div class="supa-palette-picker#if( $extraClasses && $extraClasses != '' ) $extraClasses#end">
          <select class="supa-palette-select"
                  data-supa-palette-select="true"
                  aria-label="$esc.html( $supaLabels.colorScheme )">
            <optgroup label="$esc.html( $supaLabels.colorSchemeStandard )">
#foreach( $supaOptionId in $supaPaletteNames.keySet() )
#if( $supaOptionId == 'modus' )
            </optgroup>
            <optgroup label="$esc.html( $supaLabels.colorSchemeHighContrast )">
#end
              <option value="$supaOptionId"#if( $paletteId == $supaOptionId ) selected#end>$esc.html( $supaPaletteNames.get( $supaOptionId ) )</option>
#end
            </optgroup>
          </select>
          <svg class="supa-palette-picker-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 6 8 10 12 6"></polyline></svg>
        </div>
