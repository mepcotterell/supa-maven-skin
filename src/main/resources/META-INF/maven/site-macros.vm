## Render Furo-styled Previous / Next navigation cards at bottom of article
#macro( furoPrevNextNavigation $menus )
#set( $flatNavItems = [] )
#if( $menus )
#foreach( $menu in $menus )
#foreach( $item in $menu.items )
#furoCollectNavItem( $item $flatNavItems )
#end
#end
#end
#set( $currentIndex = -1 )
#set( $idx = 0 )
#foreach( $navItem in $flatNavItems )
#if( $currentIndex == -1 && $alignedFileName == $navItem.href )
#set( $currentIndex = $idx )
#end
#set( $idx = $idx + 1 )
#end
#set( $prevItem = false )
#set( $nextItem = false )
#if( $currentIndex > 0 )
#set( $prevIndex = $currentIndex - 1 )
#set( $prevItem = $flatNavItems.get( $prevIndex ) )
#end
#set( $nextIndex = $currentIndex + 1 )
#if( $currentIndex >= 0 && $nextIndex < $flatNavItems.size() )
#set( $nextItem = $flatNavItems.get( $nextIndex ) )
#end
#if( $prevItem || $nextItem )
    <nav class="furo-related-pages not-prose" aria-label="Page navigation">
#if( $nextItem )
      <a class="furo-next-page" href="$nextItem.href">
        <div class="furo-page-info">
          <div class="furo-context">
            <span>Next</span>
          </div>
          <div class="furo-title">$esc.html( $nextItem.name )</div>
        </div>
