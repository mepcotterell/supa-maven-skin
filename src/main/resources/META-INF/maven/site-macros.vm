##
## Render a single sidebar menu item (supports collapsible <details>/<summary> for nested items)
#macro( supaSidebarMenuItem $item $depth $collapseDepth )
#supaMenuItemHref( $item.href )
#set( $currentItemHref = $itemHref )
#set( $isCurrent = $itemIsCurrent )
#supaHasActiveChild( $item )
#set( $isBranchActive = $hasActive )
#if( $item.items && $item.items.size() > 0 )
#set( $shouldOpen = ( $isCurrent || $isBranchActive || !$item.collapse || $depth <= $collapseDepth ) )
      <li class="supa-nav-item supa-nav-has-children#if( $currentItemHref ) has-link#end#if( $isCurrent ) is-current#end#if( $isBranchActive ) is-active-branch#end" data-depth="$depth">
## A linked parent renders its <a> before <details>: a link inside <summary> is a focusable
## element nested in another interactive control (axe nested-interactive, WCAG 4.1.2), so the
## summary carries only the chevron toggle and is overlaid on the link row by CSS.
#if( $currentItemHref )
        <a class="supa-nav-link#if( $isCurrent ) active#end" href="$currentItemHref"#if( $isCurrent ) aria-current="page"#end>$esc.html( $item.name )</a>
#end
        <details class="supa-nav-details"#if( $shouldOpen ) open="open"#end>
#if( $currentItemHref )
#supaFillLabel( $esc.html( $supaLabels.navSectionToggle ) 'name' $esc.html( $item.name ) )
          <summary class="supa-nav-summary" aria-label="$supaFilled">
#else
          <summary class="supa-nav-summary">
            <span class="supa-nav-link supa-nav-label">$esc.html( $item.name )</span>
#end
            <span class="supa-nav-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </summary>
          <ul class="supa-nav-sublist list-unstyled">
#set( $childDepth = $depth + 1 )
#foreach( $child in $item.items )
#supaSidebarMenuItem( $child $childDepth $collapseDepth )
#end
#set( $depth = $childDepth - 1 )
          </ul>
        </details>
      </li>
#else
      <li class="supa-nav-item#if( $isCurrent ) is-current#end" data-depth="$depth">
        <a class="supa-nav-link#if( $isCurrent ) active#end" href="$currentItemHref"#if( $isCurrent ) aria-current="page"#end#if( $item.target ) target="$item.target"#end>
          <span class="supa-nav-text">$esc.html( $item.name )</span>
        </a>
      </li>
#end
#end
##
