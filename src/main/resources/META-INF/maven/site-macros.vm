##
## Render a single sidebar menu item (supports collapsible <details>/<summary> for nested items)
#macro( furoSidebarMenuItem $item $depth $collapseDepth )
#set( $isCurrent = ( $alignedFileName == $item.href ) )
#furoHasActiveChild( $item )
#set( $isBranchActive = $hasActive )
#if( $item.items && $item.items.size() > 0 )
#set( $shouldOpen = ( $isCurrent || $isBranchActive || !$item.collapse || $depth <= $collapseDepth ) )
      <li class="furo-nav-item furo-nav-has-children#if( $isCurrent ) is-current#end#if( $isBranchActive ) is-active-branch#end" data-depth="$depth">
        <details class="furo-nav-details"#if( $shouldOpen ) open="open"#end>
          <summary class="furo-nav-summary">
#if( $item.href )
            <a class="furo-nav-link#if( $isCurrent ) active#end" href="$item.href"#if( $isCurrent ) aria-current="page"#end>$esc.html( $item.name )</a>
#else
            <span class="furo-nav-link furo-nav-label">$esc.html( $item.name )</span>
#end
            <span class="furo-nav-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </summary>
          <ul class="furo-nav-sublist list-unstyled">
#set( $childDepth = $depth + 1 )
#foreach( $child in $item.items )
#furoSidebarMenuItem( $child $childDepth $collapseDepth )
#end
#set( $depth = $childDepth - 1 )
          </ul>
        </details>
      </li>
#else
      <li class="furo-nav-item#if( $isCurrent ) is-current#end" data-depth="$depth">
        <a class="furo-nav-link#if( $isCurrent ) active#end" href="$item.href"#if( $isCurrent ) aria-current="page"#end#if( $item.target ) target="$item.target"#end>
          <span class="furo-nav-text">$esc.html( $item.name )</span>
        </a>
      </li>
#end
#end
##
## Render all menus in the left sidebar
#macro( furoSidebarMenus $menus $collapseDepth )
#if( $menus && $menus.size() > 0 )
#foreach( $menu in $menus )
      <div class="furo-nav-group">
#if( $menu.name )
        <div class="furo-nav-caption" role="heading" aria-level="2">$esc.html( $menu.name )</div>
#end
        <ul class="furo-nav-list list-unstyled">
#foreach( $item in $menu.items )
#furoSidebarMenuItem( $item 1 $collapseDepth )
#end
        </ul>
      </div>
#end
#end
#end
