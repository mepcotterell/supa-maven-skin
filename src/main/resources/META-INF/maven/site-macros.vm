##
## Render Furo-styled Previous / Next navigation cards at bottom of article
#macro( supaPrevNextNavigation $menus )
#set( $flatNavItems = [] )
#if( $menus )
#foreach( $menu in $menus )
#foreach( $item in $menu.items )
#supaCollectNavItem( $item $flatNavItems )
#end
#end
#end
#set( $currentIndex = -1 )
#set( $idx = 0 )
#foreach( $navItem in $flatNavItems )
#supaMenuItemHref( $navItem.href )
#if( $currentIndex == -1 && $alignedFileName == $itemHref )
#set( $currentIndex = $idx )
#end
#set( $idx = $idx + 1 )
#end
#set( $prevItem = false )
#set( $nextItem = false )
#if( $currentIndex > 0 )
#set( $prevIndex = $currentIndex - 1 )
#set( $prevItem = $flatNavItems.get( $prevIndex ) )
#end
#set( $nextIndex = $currentIndex + 1 )
#if( $currentIndex >= 0 && $nextIndex < $flatNavItems.size() )
#set( $nextItem = $flatNavItems.get( $nextIndex ) )
#end
#if( $prevItem || $nextItem )
    <nav class="supa-related-pages not-prose" aria-label="Page navigation">
#if( $prevItem )
#supaMenuItemHref( $prevItem.href )
      <a class="supa-prev-page" href="$itemHref">
        <svg class="supa-related-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <div class="supa-page-info">
          <div class="supa-context">
            <span>Previous</span>
          </div>
          <div class="supa-title">$esc.html( $prevItem.name )</div>
        </div>
      </a>
#end
#if( $nextItem )
#supaMenuItemHref( $nextItem.href )
      <a class="supa-next-page" href="$itemHref">
        <div class="supa-page-info">
          <div class="supa-context">
            <span>Next</span>
          </div>
          <div class="supa-title">$esc.html( $nextItem.name )</div>
