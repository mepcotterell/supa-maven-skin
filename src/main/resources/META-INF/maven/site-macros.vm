##
## Build $supaLabels (key -> plain text) from the English defaults, then the <tocTitle> shorthand,
## then each <labels> child, so a <labels><tocTitle> wins over <tocTitle>. An empty or blank value
## keeps the English: an empty accessible name fails WCAG 4.1.2. Also sets $supaLabelOverrides
## (the keys the site set, for the data-supa-label-* attributes) and $supaUnknownLabels (<labels>
## children that name no key, such as a misspelled <serchPlaceholder>, for the console warning).
## Reads <supaSkin>, or the legacy <furoSkin> block when <supaSkin> is absent, like site.vm. It
## takes no arguments so the #bsAlert macro can also call it from a .md.vm page, where site.vm
## has not run but $site is available.
#macro( supaBuildLabels )
#supaLabelDefaults()
#if( $site.getCustomChild( 'supaSkin' ) )
#set( $supaLabelCfg = 'supaSkin' )
#else
#set( $supaLabelCfg = 'furoSkin' )
#end
#set( $supaLabels = {} )
#set( $_ = $supaLabels.putAll( $supaLabelDefaults ) )
#set( $supaLabelOverrides = {} )
#set( $supaUnknownLabels = [] )
#set( $supaLabelRaw = $site.getCustomValue( "${supaLabelCfg}.tocTitle", '' ) )
#set( $supaLabelValue = "$!supaLabelRaw" )
#if( $supaLabelValue.trim() != '' )
#set( $_ = $supaLabels.put( 'tocTitle', $supaLabelValue.trim() ) )
#set( $_ = $supaLabelOverrides.put( 'tocTitle', $supaLabelValue.trim() ) )
#end
#set( $supaLabelNode = $site.getCustomChild( "${supaLabelCfg}.labels" ) )
#if( $supaLabelNode )
#foreach( $supaLabelChild in $supaLabelNode.getChildren() )
#set( $supaLabelKey = $supaLabelChild.getName() )
#set( $supaLabelRaw = $supaLabelChild.getValue() )
#set( $supaLabelValue = "$!supaLabelRaw" )
#if( !$supaLabelDefaults.containsKey( $supaLabelKey ) )
#set( $_ = $supaUnknownLabels.add( $supaLabelKey ) )
#elseif( $supaLabelValue.trim() != '' )
#set( $_ = $supaLabels.put( $supaLabelKey, $supaLabelValue.trim() ) )
#set( $_ = $supaLabelOverrides.put( $supaLabelKey, $supaLabelValue.trim() ) )
#end
#end
#end
#end
##
## Fill the {$placeholder} in an already HTML-escaped label $labelHtml with the HTML $valueHtml
## into $supaFilled. An empty $valueHtml removes the placeholder and the whitespace before it, so
## "Copyright © {years} {organization}." without an organization reads "Copyright © 2026."
## The regex pieces are single-quoted so Velocity keeps their backslashes.
#macro( supaFillLabel $labelHtml $placeholder $valueHtml )
#if( "$!valueHtml" == '' )
#set( $supaFillStart = '\s*\{' )
#set( $supaFillEnd = '\}' )
#set( $supaFilled = $labelHtml.replaceAll( "${supaFillStart}${placeholder}${supaFillEnd}", '' ).trim() )
#else
#set( $supaFilled = $labelHtml.replace( "{${placeholder}}", $valueHtml ) )
#end
#end
##
## Doxia hands site.xml hrefs (menus, breadcrumbs, <bannerLeft>) to the template relative to the
## site root, and maven-site-plugin even turns same-site absolute URLs into root-relative ones when
## pom.xml sets <url>. The reports menu adds the synthetic root-relative /project-info.html and
## /project-reports.html. A page in a subdirectory (guides/install.html, $relativePath "..") needs
## them relative to its own directory, which Fluido does with $PathTool.calculateLink(). Unlike
## PathTool, any other "/path" stays unchanged, as the documented logo options promise.
##
## Classify $href: $isSiteHref is true for a link inside the site, and $siteHref is then its
## site-root-relative form (synthetic "/" and leading "./" removed). URLs with a scheme (https:,
## mailto:, ...), "/" and "//" paths, and "#fragment" links set $isSiteHref to false.
#macro( supaSiteHref $href )
#set( $isSiteHref = false )
#set( $siteHref = '' )
#if( $href && ( $href == "/project-info.html" || $href == "/project-reports.html" ) )
#set( $isSiteHref = true )
#set( $siteHref = $href.substring( 1 ) )
#elseif( $href && !$href.startsWith( "/" ) && !$href.startsWith( "#" ) && !$href.matches( '[A-Za-z][A-Za-z0-9+.-]*:.*' ) )
#set( $isSiteHref = true )
#set( $siteHref = $href.replaceFirst( '^([.]/)+', '' ) )
#end
#end
##
## Resolve $href for the page being rendered into $resolvedHref: links inside the site gain the
## $relativePath prefix (".", "..", "../.."), and every other link is returned unchanged
#macro( supaResolveHref $href )
#supaSiteHref( $href )
#if( $isSiteHref && ( $relativePath != "." || $siteHref == "" ) )
#set( $resolvedHref = "$relativePath/$siteHref" )
#elseif( $isSiteHref )
#set( $resolvedHref = $siteHref )
#else
#set( $resolvedHref = $href )
#end
#end
##
## Resolve a menu item href into $itemHref and set $itemIsCurrent when it names the page being
## rendered. The check compares site-root-relative paths: Doxia's $currentFileName (for example
## guides/install.html) against $siteHref. $alignedFileName is page-relative on pages in
## subdirectories (../guides/install.html), so it is not used here.
#macro( supaMenuItemHref $href )
#supaResolveHref( $href )
#set( $itemHref = $resolvedHref )
#set( $itemIsCurrent = ( $isSiteHref && $siteHref == $currentFileName ) )
#end
