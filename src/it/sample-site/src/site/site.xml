<?xml version="1.0" encoding="UTF-8"?>
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Sample Supa Site">

  <skin>
    <groupId>${skinGroupId}</groupId>
    <artifactId>${skinArtifactId}</artifactId>
    <version>${skinVersion}</version>
  </skin>

  <custom>
    <supaSkin>
      <defaultTheme>auto</defaultTheme>
      <announcement>Integration Test Announcement</announcement>
      <sourceRepository>https://github.com/mepcotterell/supa-maven-skin</sourceRepository>
      <sourceBranch>main</sourceBranch>
      <sourceDirectory>src/site</sourceDirectory>
      <stickyContentHeader>true</stickyContentHeader>
      <lightLogo>images/logo.svg</lightLogo>
      <mermaidCdnUrl>https://example.org/vendor/mermaid/mermaid.min.js</mermaidCdnUrl>
      <lightCssVariables>
        <color-brand-primary>#0055ff</color-brand-primary>
      </lightCssVariables>
      <darkCssVariables>
        <color-brand-primary>#6699ff</color-brand-primary>
      </darkCssVariables>
    </supaSkin>
  </custom>

  <body>
    <breadcrumbs>
      <item name="Maven" href="https://maven.apache.org/" />
      <item name="Docs" href="guide.html" />
    </breadcrumbs>
    <menu name="Documentation">
      <item name="Welcome" href="index.html" />
      <item name="User Guide" href="guide.html" />
      <item name="Installation" href="guides/install.html" />
    </menu>
    <menu ref="reports" />
  </body>
</site>
