<?xml version="1.0" encoding="UTF-8"?>
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Sample Supa Site">

  <skin>
    <groupId>${skinGroupId}</groupId>
    <artifactId>${skinArtifactId}</artifactId>
    <version>${skinVersion}</version>
  </skin>

  <custom>
    <supaSkin>
      <!-- Not a polarity, so the skin starts in auto -->
      <defaultTheme>sepia</defaultTheme>
      <colorScheme>bootstrap</colorScheme>
      <announcement>Integration Test Announcement</announcement>
      <sourceRepository>https://github.com/mepcotterell/supa-maven-skin</sourceRepository>
      <sourceBranch>main</sourceBranch>
      <sourceDirectory>src/site</sourceDirectory>
      <stickyContentHeader>true</stickyContentHeader>
      <tocTitle>Sur cette page</tocTitle>
      <!-- Not a language tag, so <html lang> must stay "en" -->
      <language>de DE</language>
      <labels>
        <pageNext>Suivant</pageNext>
        <footerLastUpdated>Mis à jour le {date}.</footerLastUpdated>
        <searchNoResults>Aucun résultat pour « {query} »</searchNoResults>
        <alertDismiss>Fermer</alertDismiss>
        <backToTop></backToTop>
        <serchPlaceholder>Rechercher</serchPlaceholder>
        <breadcrumb>Fil <b>d'Ariane</b></breadcrumb>
      </labels>
      <lightLogo>images/logo.svg</lightLogo>
      <navIcons>
        <icon>
          <href>guide.html</href>
          <title>User Guide</title>
          <html><![CDATA[<i class="bi bi-book" aria-hidden="true"></i>]]></html>
        </icon>
        <icon>
          <href>https://github.com/mepcotterell/supa-maven-skin</href>
          <title>GitHub Repository</title>
          <html><![CDATA[<i class="bi bi-github" aria-hidden="true"></i>]]></html>
        </icon>
      </navIcons>
      <mermaidCdnUrl>https://example.org/vendor/mermaid/mermaid.min.js</mermaidCdnUrl>
      <!-- npm run test:a11y scans this site too, so the author colors must meet 4.5:1 on the
           page and on the brand-tinted current-page fill -->
      <lightCssVariables>
        <color-brand-primary>#0047cc</color-brand-primary>
        <!-- CSS keeps its quotes, and "</style" cannot end the style element -->
        <supa-fixture-font>"Fira Sans", sans-serif</supa-fixture-font>
        <supa-fixture-marker>"&lt;/style&gt;&lt;p id=supaCssBreakout&gt;light&lt;/p&gt;"</supa-fixture-marker>
      </lightCssVariables>
      <darkCssVariables>
        <color-brand-primary>#80aaff</color-brand-primary>
        <supa-fixture-marker>"&lt;/STYLE&gt;&lt;p id=supaCssBreakout&gt;dark&lt;/p&gt;"</supa-fixture-marker>
      </darkCssVariables>
    </supaSkin>
  </custom>

  <body>
    <breadcrumbs>
      <item name="Maven" href="https://maven.apache.org/" />
      <item name="Docs" href="guide.html" />
    </breadcrumbs>
    <menu name="Documentation">
      <item name="Welcome" href="index.html" />
      <item name="User Guide" href="guide.html" />
      <item name="Installation" href="guides/install.html" />
      <!-- Three levels, with an item after the nested group, for the sidebar's deepest branch.
           Section links only, so the Previous / Next cards ignore them. -->
      <item name="Guide Sections" href="guide.html#configuration">
        <item name="Configuration" href="guide.html#configuration">
          <item name="Skin Snippet" href="guide.html#configuration" />
        </item>
        <item name="Install Section" href="guide.html#1-install" />
      </item>
    </menu>
    <menu ref="reports" />
  </body>
</site>
