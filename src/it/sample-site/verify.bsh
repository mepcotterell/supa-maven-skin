import java.io.File;
import java.nio.file.Files;
import java.nio.charset.StandardCharsets;
import java.util.jar.JarFile;

File siteDir = new File( basedir, "target/site" );
if ( !siteDir.isDirectory() ) {
    throw new IllegalStateException( "target/site directory was not generated" );
}

// Inspect the packaged skin JAR directly to verify META-INF/ license entries and root cleanliness
File targetDir = new File( basedir, "../.." );
File[] jarCandidates = targetDir.listFiles();
File skinJar = null;
if ( jarCandidates != null ) {
    for ( int i = 0; i < jarCandidates.length; i++ ) {
        String name = jarCandidates[i].getName();
        if ( name.startsWith( "supa-maven-skin-" ) && name.endsWith( ".jar" )
             && !name.endsWith( "-sources.jar" ) && !name.endsWith( "-javadoc.jar" ) ) {
            skinJar = jarCandidates[i];
            break;
        }
    }
}
if ( skinJar == null || !skinJar.isFile() ) {
    throw new IllegalStateException( "Could not locate packaged supa-maven-skin-*.jar in target/" );
}

JarFile jarFile = new JarFile( skinJar );
try {
    String[] requiredEntries = new String[] {
        "META-INF/LICENSE",
        "META-INF/THIRD-PARTY-LICENSES.txt",
        "META-INF/licenses/LICENSE-bootstrap.txt",
        "META-INF/licenses/LICENSE-bootstrap-icons.txt",
        "META-INF/licenses/LICENSE-highlight.js.txt",
        "META-INF/licenses/LICENSE-vanilla-calendar-pro.txt",
        "META-INF/licenses/LICENSE-floating-ui-dom.txt",
        "META-INF/licenses/LICENSE-floating-ui-core.txt",
        "META-INF/licenses/LICENSE-floating-ui-utils.txt"
    };
    for ( int i = 0; i < requiredEntries.length; i++ ) {
        if ( jarFile.getEntry( requiredEntries[i] ) == null ) {
            throw new IllegalStateException( "Missing required JAR entry: " + requiredEntries[i] );
        }
    }
    if ( jarFile.getEntry( "LICENSE" ) != null || jarFile.getEntry( "THIRD-PARTY-LICENSES.txt" ) != null ) {
        throw new IllegalStateException( "License files must be under META-INF/, not at the root of the skin JAR" );
    }
} finally {
    jarFile.close();
}

File cssFile = new File( siteDir, "css/supa-maven-skin.min.css" );
if ( !cssFile.isFile() || cssFile.length() < 1000 ) {
    throw new IllegalStateException( "Bundled CSS asset missing or empty" );
}
String cssHead = Files.readString( cssFile.toPath(), StandardCharsets.UTF_8 );
if ( !cssHead.startsWith( "/*!" ) || !cssHead.contains( "META-INF/THIRD-PARTY-LICENSES.txt" ) ) {
    throw new IllegalStateException( "Bundled CSS asset is missing /*! ... */ license attribution header" );
}

File jsFile = new File( siteDir, "js/supa-maven-skin.min.js" );
if ( !jsFile.isFile() || jsFile.length() < 1000 ) {
    throw new IllegalStateException( "Bundled JS asset missing or empty" );
}
String jsHead = Files.readString( jsFile.toPath(), StandardCharsets.UTF_8 );
if ( !jsHead.startsWith( "/*!" ) || !jsHead.contains( "META-INF/THIRD-PARTY-LICENSES.txt" ) ) {
    throw new IllegalStateException( "Bundled JS asset is missing /*! ... */ license attribution header" );
}
// Bootstrap 6's Tooltip/Popover/Menu and Datepicker compile their peer dependencies into the JS
// bundle; the 0.1.0 banner and notices omitted them.
String jsBanner = jsHead.substring( 0, jsHead.indexOf( "*/" ) );
String[] bundledPeers = new String[] { "vanilla-calendar-pro", "@floating-ui/dom", "@floating-ui/core", "@floating-ui/utils" };
for ( int i = 0; i < bundledPeers.length; i++ ) {
    if ( !jsBanner.contains( bundledPeers[i] ) ) {
        throw new IllegalStateException( "JS license banner does not name bundled package " + bundledPeers[i] );
    }
}
// Widgets only author content uses (LAZY_WIDGETS in bootstrap-components.ts) load on demand from
// chunks beside the entry, so the skin JAR must ship them and consumer sites must serve them. Each
// chunk imports shared code (Bootstrap's patched Data map, Menu, the skin's helpers) from the
// entry rather than carrying a second copy.
String[] lazyChunks = new String[] {
    "carousel", "chips", "combobox", "datepicker", "nav-overflow", "otp-input", "playground", "range", "strength", "tab"
};
for ( int i = 0; i < lazyChunks.length; i++ ) {
    String chunkPath = "js/supa-maven-skin-" + lazyChunks[i] + ".min.js";
    File chunkFile = new File( siteDir, chunkPath );
    if ( !chunkFile.isFile() || chunkFile.length() < 500 ) {
        throw new IllegalStateException( "Lazily loaded JS chunk missing or empty: " + chunkPath );
    }
    String chunkText = Files.readString( chunkFile.toPath(), StandardCharsets.UTF_8 );
    if ( !chunkText.startsWith( "/*!" ) || !chunkText.contains( "META-INF/LICENSE" ) ) {
        throw new IllegalStateException( chunkPath + " is missing its /*! ... */ license attribution header" );
    }
    if ( !chunkText.contains( "\"./supa-maven-skin.min.js\"" ) ) {
        throw new IllegalStateException( chunkPath + " does not import shared code from js/supa-maven-skin.min.js" );
    }
}
String datepickerChunk = Files.readString( new File( siteDir, "js/supa-maven-skin-datepicker.min.js" ).toPath(), StandardCharsets.UTF_8 );
if ( !datepickerChunk.substring( 0, datepickerChunk.indexOf( "*/" ) ).contains( "vanilla-calendar-pro" ) ) {
    throw new IllegalStateException( "Datepicker chunk license banner does not name bundled package vanilla-calendar-pro" );
}
if ( !jsHead.contains( "supa-maven-skin-datepicker.min.js" ) ) {
    throw new IllegalStateException( "JS entry does not reference its lazily loaded Datepicker chunk" );
}

File indexHtml = new File( siteDir, "index.html" );
if ( !indexHtml.isFile() ) {
    throw new IllegalStateException( "index.html was not generated" );
}
String html = Files.readString( indexHtml.toPath(), StandardCharsets.UTF_8 );

if ( !html.contains( "class=\"supa-page\"" ) ) {
    throw new IllegalStateException( "Missing Furo 3-column page wrapper" );
}
if ( !html.contains( "id=\"supaSidebarDrawer\"" ) || !html.contains( "lg:drawer drawer-start supa-sidebar-drawer" ) ) {
    throw new IllegalStateException( "Missing Bootstrap 6 left sidebar drawer" );
}
if ( !html.contains( "class=\"supa-sidebar-brand\" data-supa-brand-align=\"center\"" ) ) {
    throw new IllegalStateException( "Missing center-aligned default data-supa-brand-align on .supa-sidebar-brand" );
}
if ( !html.contains( "id=\"supaTocDrawer\"" ) || !html.contains( "xl:drawer drawer-end supa-toc-drawer" ) ) {
    throw new IllegalStateException( "Missing Bootstrap 6 right TOC drawer" );
}
// <tocTitle> (localized here) must name the TOC <aside> landmark as well as its <nav>, or screen
// readers list the landmark under the English default.
java.util.regex.Matcher tocAsideLabel = java.util.regex.Pattern.compile( "<aside class=\"supa-toc-column\" aria-label=\"([^\"]*)\"" ).matcher( html );
java.util.regex.Matcher tocNavLabel = java.util.regex.Pattern.compile( "<nav id=\"supaTocNav\"[^>]*\\saria-label=\"([^\"]*)\"" ).matcher( html );
if ( !tocAsideLabel.find() || !tocNavLabel.find()
     || !"Sur cette page".equals( tocAsideLabel.group( 1 ) ) || !tocAsideLabel.group( 1 ).equals( tocNavLabel.group( 1 ) ) ) {
    throw new IllegalStateException( "TOC <aside> aria-label must follow <tocTitle> (\"Sur cette page\"), like the TOC <nav>" );
}
if ( !html.contains( "data-bs-scroll=" ) || !html.contains( "data-bs-backdrop=" ) ) {
    throw new IllegalStateException( "Missing drawer data-bs-scroll / data-bs-backdrop attributes" );
}
if ( !html.contains( "id=\"supaSearchDialog\"" ) ) {
    throw new IllegalStateException( "Missing Bootstrap 6 search dialog" );
}
if ( !html.contains( "bi-file-earmark-code" ) || !html.contains( "bi-pencil-square" ) ) {
    throw new IllegalStateException( "Missing Bootstrap Icons for View page source or Edit this page buttons" );
}
if ( !html.contains( "bi-sun supa-theme-icon supa-theme-icon-light" )
     || !html.contains( "bi-moon-stars supa-theme-icon supa-theme-icon-dark" )
     || !html.contains( "bi-circle-half supa-theme-icon supa-theme-icon-auto" ) ) {
    throw new IllegalStateException( "Missing Bootstrap Icons on theme toggle button" );
}
if ( !html.contains( "class=\"supa-body supa-sticky-content-header\"" ) ) {
    throw new IllegalStateException( "Missing supa-sticky-content-header body class for <stickyContentHeader>true</stickyContentHeader>" );
}
// toc.ts reads <headingPermalinks> back from this exact attribute name; 0.1.0/0.1.1 read a name
// site.vm never emitted, so <headingPermalinks>false</headingPermalinks> had no effect.
if ( !java.util.regex.Pattern.compile( "<body\\b[^>]*\\sdata-supa-permalinks=\"true\"" ).matcher( html ).find() ) {
    throw new IllegalStateException( "Missing default data-supa-permalinks=\"true\" on <body> for <headingPermalinks>" );
}
// Pinned Mermaid/KaTeX CDN defaults (and their SRI hashes) live only in optional.ts, so site.vm
// emits data-supa-*-url attributes solely for consumer overrides.
if ( !html.contains( "data-supa-mermaid=\"auto\"" ) || !html.contains( "data-supa-katex=\"auto\"" ) ) {
    throw new IllegalStateException( "Missing data-supa-mermaid / data-supa-katex mode attributes" );
}
if ( !html.contains( "data-supa-mermaid-url=\"https://example.org/vendor/mermaid/mermaid.min.js\"" ) ) {
    throw new IllegalStateException( "Missing <mermaidCdnUrl> override in data-supa-mermaid-url" );
}
if ( html.contains( "data-supa-katex-css-url=" ) || html.contains( "data-supa-katex-js-url=" ) || html.contains( "cdn.jsdelivr.net" ) ) {
    throw new IllegalStateException( "Default KaTeX/Mermaid CDN URLs must not be emitted by site.vm (pinned in optional.ts)" );
}
if ( !html.contains( "Integration Test Announcement" ) ) {
    throw new IllegalStateException( "Missing custom announcement banner" );
}
if ( !html.contains( "--color-brand-primary: #0055ff;" ) ) {
    throw new IllegalStateException( "Missing custom lightCssVariables" );
}
if ( !html.contains( "--color-brand-primary: #6699ff;" ) ) {
    throw new IllegalStateException( "Missing custom darkCssVariables" );
}
// A printout uses the light polarity on white paper, so dark overrides must not apply in print
if ( !html.contains( "@media screen {" ) || !html.contains( "@media screen and (prefers-color-scheme: dark) {" ) ) {
    throw new IllegalStateException( "Custom darkCssVariables must be scoped to @media screen" );
}
if ( !html.contains( "supa-next-page" ) || !html.contains( "guide.html" ) ) {
    throw new IllegalStateException( "Missing Next page navigation card on index.html" );
}

File guideHtml = new File( siteDir, "guide.html" );
if ( !guideHtml.isFile() ) {
    throw new IllegalStateException( "guide.html was not generated" );
}
String guideText = Files.readString( guideHtml.toPath(), StandardCharsets.UTF_8 );
if ( !guideText.contains( "supa-prev-page" ) ) {
    throw new IllegalStateException( "Missing Previous page navigation card on guide.html" );
}
// site.vm marks a link whose text is its own URL, so print styles do not print that URL twice
if ( !java.util.regex.Pattern.compile( "<a [^>]*href=\"https://maven\\.apache\\.org/\"[^>]* data-supa-bare-url>https://maven\\.apache\\.org/</a>" ).matcher( guideText ).find()
     || guideText.contains( "data-supa-bare-url>Maven Site Plugin documentation</a>" ) ) {
    throw new IllegalStateException( "Expected data-supa-bare-url on the bare-URL link only in guide.html" );
}
// Doxia passes the fragment of a relative Markdown link that is not a valid Doxia ID through
// DoxiaUtils.encodeId, so [..](#überblick) is written as #a.C3.BCberblick. prepareHeadings() in
// toc.ts adds an anchor with that ID before each heading whose ID is not a valid Doxia ID; if Doxia
// changes this encoding, change doxiaLinkId() in toc.ts to match.
if ( !guideText.contains( "href=\"#a.C3.BCberblick\"" ) ) {
    throw new IllegalStateException( "Expected Doxia to write the Markdown link to #überblick in guide.html as #a.C3.BCberblick" );
}
// The same holds for an ID that starts with a digit: Doxia prefixes an "a", so [..](#1-install)
// is written as #a1-install, and prepareHeadings() adds that anchor too.
if ( !guideText.contains( "href=\"#a1-install\"" ) || guideText.contains( "href=\"#1-install\"" ) ) {
    throw new IllegalStateException( "Expected Doxia to write the Markdown link to #1-install in guide.html as #a1-install" );
}

if ( html.contains( "${currentYear}" ) || html.contains( "$currentDate" ) ) {
    throw new IllegalStateException( "Uninterpolated Velocity date variable found in footer" );
}

// Rendered-page accessibility invariants (also checked with axe-core by `npm run test:a11y`)
if ( html.contains( "<html lang=\"\"" ) || !html.contains( "<html lang=\"en\"" ) ) {
    throw new IllegalStateException( "<html lang> must fall back to \"en\" for Maven's default (ROOT) locale (WCAG 3.1.1)" );
}
if ( !html.contains( "supa-nav-has-children has-link" ) ) {
    throw new IllegalStateException( "Missing linked parent sidebar item for the Project Information reports menu" );
}
if ( java.util.regex.Pattern.compile( "<summary[^>]*>\\s*<a\\s" ).matcher( html ).find() ) {
    throw new IllegalStateException( "Sidebar <summary> must not contain a link (axe nested-interactive, WCAG 4.1.2)" );
}
if ( !html.contains( "aria-keyshortcuts=\"/ Meta+K Control+K\"" ) || html.contains( "Search documentation (Press" ) ) {
    throw new IllegalStateException( "Search trigger must expose its shortcut via aria-keyshortcuts with a label-in-name accessible name (WCAG 2.5.3)" );
}
// A role="menu" may own only menu items, groups, and separators; the color-scheme menu's visual
// AA/AAA headers must stay hidden from assistive technology (axe aria-required-children).
if ( !html.contains( "<h6 class=\"menu-header\" aria-hidden=\"true\">WCAG 2.2 AA Standard</h6>" )
     || html.contains( "<h6 class=\"menu-header\">" ) ) {
    throw new IllegalStateException( "Color-scheme menu headers must carry aria-hidden=\"true\" inside role=\"menu\" (axe aria-required-children, WCAG 1.3.1)" );
}
// Voice-control users activate the color-scheme trigger by saying the scheme it shows, so its
// accessible name and tooltip must contain that text (WCAG 2.5.3) before theme.ts runs, for the
// configured <colorScheme>bootstrap</colorScheme>. Up to 0.1.5 it showed "Furo (AA)" whatever the
// configuration and was named "Select accessible color scheme".
java.util.regex.Matcher paletteTriggers = java.util.regex.Pattern.compile( "<button type=\"button\"\\s+class=\"supa-palette-btn\"[^>]*>\\s*<span class=\"supa-palette-btn-label\" data-supa-palette-label=\"true\">([^<]*)</span>" ).matcher( html );
int paletteTriggerCount = 0;
while ( paletteTriggers.find() ) {
    paletteTriggerCount++;
    String paletteTrigger = paletteTriggers.group( 0 );
    if ( !"Bootstrap 6 (AA)".equals( paletteTriggers.group( 1 ) )
         || !paletteTrigger.contains( "aria-label=\"Color scheme: Bootstrap 6 (AA)\"" )
         || !paletteTrigger.contains( "data-bs-title=\"Color scheme: Bootstrap 6 (AA)\"" ) ) {
        throw new IllegalStateException( "Color-scheme trigger must show the configured scheme and be named \"Color scheme: Bootstrap 6 (AA)\" (WCAG 2.5.3 Label in Name): " + paletteTrigger );
    }
}
if ( paletteTriggerCount != 2 ) {
    throw new IllegalStateException( "Expected the mobile-header and content-header color-scheme triggers, found " + paletteTriggerCount );
}
// Opened from the bottom of the sidebar drawer, the color-scheme .menu covered all but slivers of
// the nav links above it (axe target-size, WCAG 2.5.8); the drawer footer uses a native <select>.
int drawerFooterStart = html.indexOf( "<div class=\"supa-sidebar-footer" );
int drawerFooterEnd = drawerFooterStart < 0 ? -1 : html.indexOf( "</dialog>", drawerFooterStart );
if ( drawerFooterEnd < 0 ) {
    throw new IllegalStateException( "Missing sidebar drawer Appearance footer" );
}
String drawerFooter = html.substring( drawerFooterStart, drawerFooterEnd );
if ( !drawerFooter.contains( "<select class=\"supa-palette-select\"" )
     || !drawerFooter.contains( "data-supa-palette-select=\"true\"" )
     || drawerFooter.contains( "supa-palette-btn" ) ) {
    throw new IllegalStateException( "Sidebar drawer footer must render the color-scheme picker as a native <select data-supa-palette-select> (axe target-size, WCAG 2.5.8)" );
}
// Before theme.ts runs, every color-scheme control starts on the configured scheme, so the menus
// and the drawer <select> agree with the trigger instead of always marking furo.
String checkedBootstrap = "aria-checked=\"true\" data-supa-palette-option=\"bootstrap\"";
if ( html.split( java.util.regex.Pattern.quote( checkedBootstrap ), -1 ).length - 1 != 2
     || html.contains( "aria-checked=\"true\" data-supa-palette-option=\"furo\"" )
     || !drawerFooter.contains( "<option value=\"bootstrap\" selected>" )
     || drawerFooter.contains( "<option value=\"furo\" selected>" ) ) {
    throw new IllegalStateException( "Color-scheme menus and the drawer <select> must start on the configured <colorScheme>bootstrap</colorScheme>" );
}

// Pages in subdirectories: site.xml hrefs reach the template relative to the site root, so the
// skin must rewrite menu, breadcrumb, Previous / Next, logo, and footer icon URLs for the
// directory of each page (as Fluido does). Up to 0.1.2 they were emitted unchanged, so on
// guides/install.html the "index.html" menu item pointed at the missing guides/index.html.
String siteRootPath = siteDir.getCanonicalPath() + File.separator;
java.util.regex.Pattern localUrlPattern = java.util.regex.Pattern.compile( "<(?:a|img)\\b[^>]*?\\s(?:href|src)=\"([^\"]*)\"" );
String[] linkCheckedPages = new String[] { "index.html", "guide.html", "guides/install.html" };
for ( int p = 0; p < linkCheckedPages.length; p++ ) {
    File page = new File( siteDir, linkCheckedPages[p] );
    if ( !page.isFile() ) {
        throw new IllegalStateException( linkCheckedPages[p] + " was not generated" );
    }
    java.util.regex.Matcher urlMatcher = localUrlPattern.matcher( Files.readString( page.toPath(), StandardCharsets.UTF_8 ) );
    while ( urlMatcher.find() ) {
        String url = urlMatcher.group( 1 );
        int hashIndex = url.indexOf( '#' );
        String urlPath = hashIndex >= 0 ? url.substring( 0, hashIndex ) : url;
        if ( urlPath.length() == 0 || urlPath.startsWith( "/" ) || urlPath.matches( "[A-Za-z][A-Za-z0-9+.-]*:.*" ) ) {
            continue;
        }
        File target = new File( page.getParentFile(), urlPath ).getCanonicalFile();
        if ( !target.isFile() || !target.getPath().startsWith( siteRootPath ) ) {
            throw new IllegalStateException( linkCheckedPages[p] + " links to \"" + url + "\", which does not resolve to a file in target/site" );
        }
    }
}

String installText = Files.readString( new File( siteDir, "guides/install.html" ).toPath(), StandardCharsets.UTF_8 );
String[] installExpected = new String[] {
    "data-supa-relative-path=\"..\"",
    "<a class=\"supa-nav-link\" href=\"../index.html\">",
    "<a class=\"supa-nav-link\" href=\"../guide.html\">",
    "<a class=\"supa-nav-link active\" href=\"../guides/install.html\" aria-current=\"page\">",
    "<a class=\"supa-nav-link\" href=\"../project-info.html\">Project Information</a>",
    "<a class=\"supa-nav-link\" href=\"../summary.html\">",
    "<a href=\"https://maven.apache.org/\">Maven</a>",
    "<a href=\"../guide.html\">Docs</a>",
    "<a class=\"supa-prev-page\" href=\"../guide.html\">",
    "<a class=\"supa-next-page\" href=\"../project-info.html\">",
    "<img class=\"supa-sidebar-logo\" src=\"../images/logo.svg\"",
    "<a class=\"supa-footer-icon-link\" href=\"../guide.html\"",
    "<a class=\"supa-footer-icon-link\" href=\"https://github.com/mepcotterell/supa-maven-skin\""
};
for ( int i = 0; i < installExpected.length; i++ ) {
    if ( !installText.contains( installExpected[i] ) ) {
        throw new IllegalStateException( "guides/install.html is missing " + installExpected[i] );
    }
}
if ( installText.split( "class=\"supa-nav-link active\"", -1 ).length != 2 ) {
    throw new IllegalStateException( "guides/install.html must mark exactly one sidebar item as the current page" );
}

String[] topLevelExpected = new String[] {
    "<a class=\"supa-nav-link\" href=\"guides/install.html\">",
    "<a href=\"guide.html\">Docs</a>",
    "<img class=\"supa-sidebar-logo\" src=\"images/logo.svg\"",
    "<a class=\"supa-footer-icon-link\" href=\"guide.html\""
};
for ( int i = 0; i < topLevelExpected.length; i++ ) {
    if ( !html.contains( topLevelExpected[i] ) ) {
        throw new IllegalStateException( "index.html is missing " + topLevelExpected[i] );
    }
}
if ( !guideText.contains( "<a class=\"supa-next-page\" href=\"guides/install.html\">" ) ) {
    throw new IllegalStateException( "guide.html must link its Next page card to guides/install.html" );
}

// <labels> overrides (site.xml): Velocity renders them HTML-escaped and fills their placeholders,
// and keys the site leaves alone keep their English
if ( !html.contains( "<span>Suivant</span>" ) || html.contains( "<span>Next</span>" ) ) {
    throw new IllegalStateException( "<labels><pageNext> must replace \"Next\" on the Next page card" );
}
if ( !guideText.contains( "<span>Previous</span>" ) ) {
    throw new IllegalStateException( "pagePrevious is not overridden, so the Previous page card must stay English" );
}
if ( !java.util.regex.Pattern.compile( "<span class=\"supa-last-updated\">Mis &agrave; jour le \\d{4}-\\d{2}-\\d{2}\\.</span>" ).matcher( html ).find() ) {
    throw new IllegalStateException( "<labels><footerLastUpdated> must be escaped and have {date} filled with the yyyy-MM-dd date" );
}
// Without a project organization the {organization} placeholder and the space before it go away
if ( !java.util.regex.Pattern.compile( "Copyright &copy; 2025&#x2013;\\d{4}\\.\\s*</div>" ).matcher( html ).find() ) {
    throw new IllegalStateException( "Default footerCopyright must read \"Copyright © 2025–<year>.\" when the project has no organization" );
}
if ( !html.contains( "placeholder=\"Search documentation...\"" ) ) {
    throw new IllegalStateException( "A misspelled <labels> key must not change the search placeholder" );
}
// The drawer <select> and the menus share the trigger's "Color scheme" wording
if ( html.contains( "Accessible color scheme" ) || !drawerFooter.contains( "aria-label=\"Color scheme\">" )
     || !html.contains( "class=\"menu supa-palette-menu\" role=\"menu\" aria-label=\"Color scheme\"" ) ) {
    throw new IllegalStateException( "Color-scheme <select> and menus must be named by the colorScheme label (\"Color scheme\")" );
}
// The scripts receive only overridden labels they use, as data-supa-label-<kebab-key> on <body>.
// An empty <backToTop> falls back to English, so it emits nothing; Velocity-only keys such as
// pageNext are never emitted; misspelled keys are listed for one console warning.
java.util.regex.Matcher bodyTag = java.util.regex.Pattern.compile( "<body\\b[^>]*>" ).matcher( html );
if ( !bodyTag.find() ) {
    throw new IllegalStateException( "Missing <body> tag" );
}
String bodyOpen = bodyTag.group( 0 );
if ( !bodyOpen.contains( "data-supa-label-search-no-results=\"Aucun r&eacute;sultat pour &laquo; {query} &raquo;\"" ) ) {
    throw new IllegalStateException( "<labels><searchNoResults> must reach the scripts escaped, with {query} left for them to fill: " + bodyOpen );
}
if ( bodyOpen.contains( "data-supa-label-back-to-top" ) || bodyOpen.contains( "data-supa-label-page-next" )
     || bodyOpen.contains( "data-supa-label-toc-title" ) ) {
    throw new IllegalStateException( "<body> must carry data-supa-label-* only for non-empty overrides the scripts use: " + bodyOpen );
}
if ( !bodyOpen.contains( "data-supa-unknown-labels=\"serchPlaceholder\"" ) ) {
    throw new IllegalStateException( "Unknown <labels> keys must be listed in data-supa-unknown-labels: " + bodyOpen );
}
// alertDismiss is used by both sides: doxia.ts reads it from <body>, and #bsAlert in a .md.vm
// page, which Doxia evaluates before site.vm, reads <labels> through $site itself
if ( !bodyOpen.contains( "data-supa-label-alert-dismiss=\"Fermer\"" ) ) {
    throw new IllegalStateException( "<labels><alertDismiss> must reach the scripts: " + bodyOpen );
}
String alertsText = Files.readString( new File( siteDir, "alerts.html" ).toPath(), StandardCharsets.UTF_8 );
if ( !alertsText.contains( "data-bs-dismiss=\"alert\" aria-label=\"Fermer\"" ) ) {
    throw new IllegalStateException( "#bsAlert in a .md.vm page must name its dismiss button with <labels><alertDismiss>" );
}

return true;
