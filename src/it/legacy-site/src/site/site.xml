<?xml version="1.0" encoding="UTF-8"?>
<!-- Configured with the legacy <furoSkin> block, which the skin reads when <supaSkin> is absent -->
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="Legacy Supa Site">

  <skin>
    <groupId>${skinGroupId}</groupId>
    <artifactId>${skinArtifactId}</artifactId>
    <version>${skinVersion}</version>
  </skin>

  <!-- Without <lightLogo>, the sidebar shows this image, and the brand links to its href. Here and
       below, a quote and an ampersand in each URL and target must reach the page escaped. -->
  <bannerLeft name="Legacy Banner Project" href="guide.html?from=brand&amp;q=&quot;x&quot;">
    <image src="images/banner.svg?v=1&amp;q=&quot;x&quot;" />
  </bannerLeft>

  <custom>
    <furoSkin>
      <defaultTheme>light</defaultTheme>
      <colorScheme>modus</colorScheme>
      <sidebarBrandAlign>right</sidebarBrandAlign>
      <footerVersion>false</footerVersion>
      <sourceRepository>https://github.com/example/legacy-site</sourceRepository>
      <sourceEditButton>false</sourceEditButton>
      <!-- Not numbers, so each falls back to its default -->
      <tocMaxDepth>deep</tocMaxDepth>
      <sidebarCollapseDepth>all</sidebarCollapseDepth>
      <labels>
        <skipToContent>Skip to the documentation</skipToContent>
        <searchNoResults>Nothing matches {query}</searchNoResults>
      </labels>
    </furoSkin>
  </custom>

  <body>
    <breadcrumbs>
      <item name="Example &amp; Co" href="https://example.com/docs?a=1&amp;b=&quot;2&quot;" />
    </breadcrumbs>
    <menu name="Documentation">
      <item name="Welcome" href="index.html" />
      <item name="User Guide" href="guide.html" />
      <!-- A linked, collapsed group: the default <sidebarCollapseDepth> of 1 opens it -->
      <item name="Reference" href="guide.html?view=a&amp;b=&quot;c&quot;" collapse="true">
        <item name="Details" href="index.html?part=a&amp;b=&quot;c&quot;" target="docs&amp;&quot;x&quot;" />
      </item>
    </menu>
  </body>
</site>
