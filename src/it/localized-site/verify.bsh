import java.io.File;
import java.nio.file.Files;
import java.nio.charset.StandardCharsets;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

// Renders <locales>default,fr</locales>: the default locale (Locale.ROOT) from site.xml at the
// root, and fr from site_fr.xml under /fr/. Maven reads site_fr.xml instead of site.xml, so a
// label only site.xml sets must stay English under /fr/. Non-ASCII label text is compared in the
// form the skin writes it, escaped by $esc.html into HTML 4 entities.

File siteDir = new File( basedir, "target/site" );
if ( !siteDir.isDirectory() ) {
    throw new IllegalStateException( "target/site directory was not generated" );
}

String read( String path ) {
    File file = new File( siteDir, path );
    if ( !file.isFile() ) {
        throw new IllegalStateException( path + " was not generated" );
    }
    return Files.readString( file.toPath(), StandardCharsets.UTF_8 );
}

void expect( String path, String html, String needle, String why ) {
    if ( !html.contains( needle ) ) {
        throw new IllegalStateException( path + ": " + why + " (expected " + needle + ")" );
    }
}

void reject( String path, String html, String needle, String why ) {
    if ( html.contains( needle ) ) {
        throw new IllegalStateException( path + ": " + why + " (found " + needle + ")" );
    }
}

/** Returns the opening <body ...> tag, where the data-supa-label-* attributes live. */
String bodyTag( String path, String html ) {
    Matcher m = Pattern.compile( "<body\\b[^>]*>" ).matcher( html );
    if ( !m.find() ) {
        throw new IllegalStateException( path + ": no <body> tag" );
    }
    return m.group();
}

String[] defaultPages = new String[] { "index.html", "guide.html" };
String[] frenchPages = new String[] { "fr/index.html", "fr/guide.html" };

for ( int i = 0; i < defaultPages.length; i++ ) {
    String path = defaultPages[i];
    String html = read( path );
    String body = bodyTag( path, html );

    // <language> names the language of pages rendered without a Maven locale
    expect( path, html, "<html lang=\"de\"", "default-locale page must take <language>de</language>" );

    // Template labels from site.xml
    expect( path, html, "href=\"#supa-main-content\">Zum Inhalt springen</a>", "skip link must use skipToContent" );
    expect( path, html, "<span>Auf dieser Seite</span>", "TOC title must use the tocTitle label" );
    expect( path, html, "aria-label=\"Auf dieser Seite\"", "TOC landmark must be named by the tocTitle label" );
    reject( path, html, "Shorthand loses", "<labels><tocTitle> must win over the <tocTitle> shorthand" );
    expect( path, html, "Erstellt mit <a href=\"https://maven.apache.org/plugins/maven-site-plugin/\">Maven Site</a>"
            + " und <a href=\"https://github.com/mepcotterell/supa-maven-skin\">Supa Maven Skin</a>.",
            "footerBuiltWith must keep both links in its {maven} and {skin} placeholders" );
    expect( path, html, "<span class=\"supa-last-updated\">Zuletzt aktualisiert am ", "footerLastUpdated must fill {date}" );
    Matcher lastUpdated = Pattern.compile( "Zuletzt aktualisiert am (\\d{4}-\\d{2}-\\d{2})\\." ).matcher( html );
    if ( !lastUpdated.find() ) {
        throw new IllegalStateException( path + ": the footer date must stay yyyy-MM-dd inside the translated sentence" );
    }

    // A colorSchemeTrigger without {name} still names the scheme the button shows (WCAG 2.5.3),
    // and the scheme name is translated while its WCAG level stays the skin's
    expect( path, html, "data-supa-palette-label=\"true\">Furo-Farben (AA)</span>", "trigger must show the translated scheme name" );
    expect( path, html, "data-bs-title=\"Farbschema Furo-Farben (AA)\"", "trigger tooltip must append the scheme name" );
    expect( path, html, "aria-label=\"Farbschema Furo-Farben (AA)\"", "trigger name must contain the visible scheme name" );

    // Script labels reach the scripts as <body> attributes, only for keys site.xml overrides
    expect( path, body, "data-supa-label-search-no-results=\"Keine Ergebnisse f&uuml;r &bdquo;{query}&ldquo;\"",
            "searchNoResults must be emitted escaped, with {query} left for the script" );
    expect( path, body, "data-supa-label-back-to-top=\"Nach oben\"", "backToTop must be emitted" );
    expect( path, body, "data-supa-label-color-scheme-trigger=\"Farbschema\"", "colorSchemeTrigger must be emitted" );
    expect( path, body, "data-supa-label-color-scheme-furo=\"Furo-Farben\"", "colorSchemeFuro must be emitted" );
    reject( path, body, "data-supa-label-admonition-note", "admonitionNote is set only in site_fr.xml" );
    reject( path, body, "data-supa-label-toc-title", "template-only labels must not be emitted for the scripts" );
    reject( path, body, "data-supa-label-skip-to-content", "template-only labels must not be emitted for the scripts" );
    reject( path, body, "data-supa-unknown-labels", "site.xml names no unknown label keys" );

    // Labels site.xml leaves alone stay English
    expect( path, html, "aria-label=\"Close navigation\"", "navDrawerClose must stay English" );
    expect( path, html, "aria-label=\"Color theme: Auto\"", "themeTrigger must stay English" );
    expect( path, html, "placeholder=\"Search documentation...\"", "searchPlaceholder must stay English" );
}

for ( int i = 0; i < frenchPages.length; i++ ) {
    String path = frenchPages[i];
    String html = read( path );
    String body = bodyTag( path, html );

    // The fr locale names its pages' language and beats the <language>de</language> in site_fr.xml
    expect( path, html, "<html lang=\"fr\"", "fr page must take the Maven locale over <language>" );

    // Template labels from site_fr.xml
    expect( path, html, "href=\"#supa-main-content\">Aller au contenu</a>", "skip link must use the site_fr.xml label" );
    expect( path, html, "<span>Sur cette page</span>", "TOC title must use the site_fr.xml label" );

    // Script labels from site_fr.xml
    expect( path, body, "data-supa-label-search-result-count=\"R&eacute;sultats : {count}\"",
            "searchResultCount must be emitted escaped, with {count} left for the script" );
    expect( path, body, "data-supa-label-admonition-note=\"Remarque\"", "admonitionNote must be emitted" );

    // site_fr.xml replaces site.xml, so site.xml's labels do not reach /fr/
    reject( path, html, "Zum Inhalt springen", "site.xml labels must not leak into the fr locale" );
    reject( path, body, "data-supa-label-back-to-top", "backToTop is set only in site.xml" );
    reject( path, body, "data-supa-label-search-no-results", "searchNoResults is set only in site.xml" );
    expect( path, html, "data-bs-title=\"Color scheme: Furo (AA)\"", "colorSchemeTrigger must stay English" );
    expect( path, html, "Built with <a href=\"https://maven.apache.org/plugins/maven-site-plugin/\">Maven Site</a>",
            "footerBuiltWith must stay English" );
    expect( path, html, "<span class=\"supa-last-updated\">Last updated on ", "footerLastUpdated must stay English" );
    expect( path, html, "aria-label=\"Close navigation\"", "navDrawerClose must stay English" );
}

// The Previous / Next cards: pageNext is translated in both locales, pagePrevious in neither
expect( "index.html", read( "index.html" ), "<span>Weiter</span>", "pageNext must use the site.xml label" );
expect( "guide.html", read( "guide.html" ), "<span>Previous</span>", "pagePrevious must stay English" );
expect( "fr/index.html", read( "fr/index.html" ), "<span>Suivant</span>", "pageNext must use the site_fr.xml label" );
expect( "fr/guide.html", read( "fr/guide.html" ), "<span>Previous</span>", "pagePrevious must stay English" );

return true;
