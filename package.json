{
  "name": "supa-maven-skin",
  "version": "0.1.0",
  "description": "A clean, customizable Maven Site Skin inspired by Sphinx Furo, built with Bootstrap 6 (Alpha), Vite, SCSS, and TypeScript.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src/main/frontend/vite.config.ts",
    "build": "tsc --noEmit && vite build --config src/main/frontend/vite.config.ts",
    "lint": "npm run lint:ts && npm run lint:scss && npm run lint:vm && npm run lint:docs",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx}\"",
    "lint:scss": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/lint-scss.ts",
    "lint:vm": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/lint-velocity.ts",
    "lint:docs": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/lint-docs.ts",
    "test": "vitest run --config src/main/frontend/vite.config.ts",
    "test:watch": "vitest --config src/main/frontend/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "bootstrap": "6.0.0-alpha.1",
    "bootstrap-icons": "^1.13.2",
    "highlight.js": "^11.12.0",
    "vanilla-calendar-pro": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "sass-embedded": "^1.105.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
